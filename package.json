{
	"name": "attack-shark-x3-driver",
	"version": "1.0.1",
	"description": "A TypeScript driver for the Attack Shark X3 / M600 gaming mouse, supporting wired, 2.4 GHz receiver, and BLE modes via Node.js/Bun and USB HID.",
	"author": "int3rrobang",
	"license": "MIT",
	"homepage": "https://github.com/int3rrobang/attack-shark-x3-driver#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/int3rrobang/attack-shark-x3-driver.git"
	},
	"bugs": {
		"url": "https://github.com/int3rrobang/attack-shark-x3-driver/issues"
	},
	"keywords": [
		"attack-shark",
		"x3",
		"m600",
		"mouse",
		"driver",
		"wired",
		"receiver",
		"wireless",
		"ble",
		"usb",
		"hid",
		"typescript"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"bin": {
		"attack-shark-x3": "./dist/cli.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"prepublishOnly": "bun run build",
		"build": "bunx tsc",
		"cli": "bun src/cli.ts",
		"test": "bun test",
		"lint": "bunx eslint . --ext .ts --cache --cache-strategy content",
		"lint:fix": "bunx eslint . --ext .ts --fix --cache --cache-strategy content",
		"format": "bunx prettier --check . --cache --cache-strategy content",
		"format:fix": "bunx prettier --write . --cache --cache-strategy content",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"dependencies": {
		"node-hid": "^3.3.0",
		"pino": "10.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "1.3.14",
		"@types/node": "^26.0.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"lint-staged": "^17.0.8",
		"prettier": "3.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	},
	"engines": {
		"bun": "1.3.14"
	}
}
