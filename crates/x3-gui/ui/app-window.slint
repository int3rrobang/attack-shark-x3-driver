import { Palette, ScrollView } from "std-widgets.slint";

export global Theme {
    in-out property <ColorScheme> appearance: ColorScheme.unknown;
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    out property <bool> dark-mode: appearance == ColorScheme.dark || (appearance == ColorScheme.unknown && system-dark);
    out property <color> canvas: dark-mode ? #111318 : #f4f5f8;
    out property <color> surface: dark-mode ? #1a1d24 : #ffffff;
    out property <color> surface-raised: dark-mode ? #232731 : #fbfbfd;
    out property <color> sidebar: dark-mode ? #15181e : #fafbfe;
    out property <color> text: dark-mode ? #f1f3f6 : #20232b;
    out property <color> muted: dark-mode ? #a1a7b3 : #707682;
    out property <color> faint: dark-mode ? #303541 : #e8eaf0;
    out property <color> border: dark-mode ? #353a46 : #dfe2e9;
    out property <color> accent: dark-mode ? #c4cad6 : #4d5b73;
    out property <color> accent-soft: dark-mode ? #303640 : #e9edf5;
    out property <color> success: dark-mode ? #a8d0bb : #397452;
    out property <color> warning: dark-mode ? #e3bd85 : #986325;
    out property <color> danger: dark-mode ? #edb0ae : #a34f4b;
    out property <color> danger-soft: dark-mode ? #432d32 : #f8e9e8;
    out property <color> on-accent: #f8f9fb;
    out property <color> on-primary: dark-mode ? #20232b : #f8f9fb;
    out property <color> shadow: #12141c34;
    out property <length> radius: 6px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> compact-gap: 6px;
    out property <length> control-height: 34px;
}

export struct DpiStage {
    index: string,
    value: string,
    dpi: float,
    ratio: float,
    label: string,
    accent: color,
    active: bool,
}

export struct BindingRow {
    button: string,
    location: string,
    action: string,
    original-action: string,
    editable: bool,
}

export struct ProfileRow {
    name: string,
    subtitle: string,
    active: bool,
    visible: bool,
    enabled: bool,
}

export struct DeviceRow {
    id: string,
    name: string,
    detail: string,
    selected: bool,
    connected: bool,
}

export struct UnassociatedRow {
    name: string,
    detail: string,
    can-add: bool,
    can-restore: bool,
    can-adopt: bool,
    can-associate: bool,
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    height: compact ? Theme.control-height : 38px;
    min-width: compact ? 82px : 104px;
    border-radius: Theme.radius;
    border-width: primary ? 0px : 1px;
    border-color: destructive ? Theme.danger : (button-area.has-hover ? Theme.accent : Theme.border);
    background: primary ? Theme.accent : destructive ? Theme.danger-soft : button-area.has-hover ? Theme.surface-raised : Theme.surface;
    opacity: root.enabled ? 1.0 : 0.48;

    Text {
        text: root.label;
        color: root.primary ? Theme.on-primary : root.destructive ? Theme.danger : Theme.text;
        font-size: root.compact ? 12px : 13px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    button-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> dot-color: Theme.success;
    in property <bool> compact: false;
    height: compact ? 26px : 30px;
    border-radius: Theme.radius;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 8px; alignment: start; cross-axis-alignment: center;
        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.dot-color; }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: root.compact ? 10px : 11px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    height: 32px;
    border-radius: Theme.radius;
    background: selected ? Theme.accent-soft : nav-area.has-hover ? Theme.surface-raised : transparent;

    Rectangle { x: 0px; width: 3px; height: parent.height; background: root.selected ? Theme.accent : transparent; }
    Image { x: 11px; y: 7px; width: 18px; height: 18px; source: root.icon; image-fit: contain; }
    Text {
        x: 40px; width: parent.width - 50px; height: parent.height;
        text: root.label;
        color: root.selected ? Theme.text : Theme.muted;
        font-size: 12px;
        font-weight: root.selected ? 650 : 500;
        vertical-alignment: center;
    }
    nav-area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SectionTitle inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 56px;
    background: transparent;
    Text { x: 0px; y: 0px; text: root.title; color: Theme.text; font-size: 21px; font-weight: 700; }
    Text { x: 0px; y: 31px; text: root.subtitle; color: Theme.muted; font-size: 11px; }
}

component InputField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <bool> interactive: true;
    in property <length> font-size: 12px;
    callback accepted(string);
    height: 34px;
    border-radius: Theme.radius;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: root.interactive ? Theme.surface-raised : Theme.canvas;
    opacity: root.interactive ? 1.0 : 0.58;

    if input.text.is-empty : Text {
        x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
        text: root.placeholder-text; color: Theme.muted; font-size: root.font-size;
        vertical-alignment: center; overflow: elide;
    }
    input := TextInput {
        x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
        text <=> root.text; color: Theme.text; font-size: root.font-size;
        selection-foreground-color: Theme.text; selection-background-color: Theme.accent-soft;
        vertical-alignment: center; single-line: true; enabled: root.interactive;
        accepted => { root.accepted(self.text); }
    }
}

component ThemedSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value: 0;
    in property <bool> enabled: true;
    in property <string> accessible-name: "value";
    in property <string> minimum-label;
    in property <string> maximum-label;
    callback changed(float);
    height: 52px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.48;
    property <float> value-ratio: root.maximum > root.minimum ? max(0.0, min(1.0, (root.value - root.minimum) / (root.maximum - root.minimum))) : 0.0;
    property <float> pointer-ratio: max(0.0, min(1.0, (slider-area.mouse-x - Theme.space-2) / (slider-area.width - Theme.space-4)));
    property <float> pointer-value: root.step > 0 ? root.minimum + round((root.pointer-ratio * (root.maximum - root.minimum)) / root.step) * root.step : root.minimum + root.pointer-ratio * (root.maximum - root.minimum);

    track := Rectangle {
        x: Theme.space-2; y: 16px; width: parent.width - Theme.space-4; height: Theme.space-1;
        border-radius: 2px;
        background: Theme.faint;
        Rectangle {
            x: 0px; y: 0px; width: parent.width * root.value-ratio; height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: track.x + track.width * root.value-ratio - Theme.space-2; y: Theme.space-2;
        width: Theme.space-4; height: Theme.space-4; border-radius: Theme.space-2;
        border-width: 2px; border-color: Theme.surface;
        background: Theme.accent;
    }
    Text {
        x: track.x; y: 34px; width: track.width / 2; height: 14px;
        text: root.minimum-label; color: Theme.muted; font-size: 9px;
        horizontal-alignment: left; vertical-alignment: center;
    }
    Text {
        x: track.x + track.width / 2; y: 34px; width: track.width / 2; height: 14px;
        text: root.maximum-label; color: Theme.muted; font-size: 9px;
        horizontal-alignment: right; vertical-alignment: center;
    }
    slider-area := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: 34px;
        enabled: root.enabled;
        accessible-role: slider;
        accessible-label: root.accessible-name;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.changed(max(root.minimum, min(root.maximum, root.pointer-value))); }
        moved => { if (slider-area.pressed) { root.changed(max(root.minimum, min(root.maximum, root.pointer-value))); } }
    }
}

component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <string> detail: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label + (root.detail.is-empty ? "" : ", " + root.detail);
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    height: root.compact ? 34px : 42px;
    border-radius: Theme.radius;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : (choice-area.has-hover ? Theme.accent : Theme.border);
    background: root.selected ? Theme.accent-soft : choice-area.has-hover ? Theme.surface-raised : Theme.surface;
    opacity: root.enabled ? 1.0 : 0.48;

    Text { x: 8px; y: root.detail.is-empty ? 0px : 4px; width: parent.width - 16px; height: root.detail.is-empty ? parent.height : 18px; text: root.label; color: Theme.text; font-size: root.compact ? 11px : 12px; font-weight: root.selected ? 700 : 600; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    if !root.detail.is-empty : Text { x: 8px; y: 23px; width: parent.width - 16px; height: 14px; text: root.detail; color: Theme.muted; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    choice-area := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in-out property <bool> checked;
    in property <bool> interactive: true;
    callback toggled(bool);
    height: 64px;
    background: transparent;
    opacity: root.interactive ? 1.0 : 0.58;

    Text { x: 0px; y: 8px; width: parent.width - 70px; text: root.label; color: Theme.text; font-size: 13px; font-weight: 650; }
    Text { x: 0px; y: 31px; width: parent.width - 70px; text: root.detail; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
    Rectangle {
        x: parent.width - 48px; y: 17px; width: 46px; height: 26px; border-radius: 13px;
        background: root.checked ? Theme.accent : Theme.faint;
        Rectangle { x: root.checked ? 23px : 3px; y: 3px; width: 20px; height: 20px; border-radius: 10px; background: Theme.on-accent; animate x { duration: 120ms; } }
        toggle-area := TouchArea {
            enabled: root.interactive;
            accessible-role: button;
            accessible-label: root.label + (root.checked ? " on" : " off");
            accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
            mouse-cursor: root.interactive ? pointer : default;
            clicked => { root.checked = !root.checked; root.toggled(root.checked); }
        }
    }
}

component DeviceOption inherits Rectangle {
    in property <DeviceRow> device;
    in property <int> item-index;
    callback selected(int);
    height: 38px;
    border-radius: Theme.radius;
    border-width: root.device.selected ? 2px : 1px;
    border-color: root.device.selected ? Theme.accent : Theme.border;
    background: root.device.selected ? Theme.accent-soft : device-area.has-hover ? Theme.surface-raised : Theme.surface;

    Rectangle { x: 10px; y: 14px; width: 8px; height: 8px; border-radius: 4px; background: root.device.connected ? Theme.success : Theme.warning; }
    Text { x: 26px; y: 4px; width: parent.width - 38px; height: 16px; text: root.device.name; color: Theme.text; font-size: 11px; font-weight: 650; overflow: elide; }
    Text { x: 26px; y: 20px; width: parent.width - 38px; height: 13px; text: root.device.detail; color: Theme.muted; font-size: 9px; overflow: elide; }
    device-area := TouchArea {
        accessible-role: button;
        accessible-label: root.device.name + ", " + root.device.detail;
        accessible-action-default => { root.selected(root.item-index); }
        mouse-cursor: pointer;
        clicked => { root.selected(root.item-index); }
    }
}

component DeviceSelectorPanel inherits Card {
    in property <[DeviceRow]> devices;
    in property <int> device-count: 0;
    in property <bool> interactive: true;
    callback select-device(int);
    height: 112px;

    Text { x: 12px; y: 8px; text: "devices"; color: Theme.text; font-size: 12px; font-weight: 700; }
    if root.device-count == 0 : Text { x: 12px; y: 28px; width: parent.width - 24px; text: "No compatible devices found"; color: Theme.warning; font-size: 10px; }
    if root.device-count > 1 : Text { x: 12px; y: 28px; width: parent.width - 24px; text: "Choose a device; wired, receiver, and BLE details stay visible"; color: Theme.muted; font-size: 9px; }

    ScrollView {
        x: Theme.space-2; y: root.device-count == 1 ? 28px : 44px; width: parent.width - Theme.space-4; height: parent.height - (root.device-count == 1 ? 34px : 50px);
        VerticalLayout {
            width: parent.width;
            spacing: 3px;
            for device[index] in root.devices : DeviceOption {
                device: device;
                item-index: index;
                opacity: root.interactive ? 1.0 : 0.58;
                selected(index) => { if (root.interactive) { root.select-device(index); } }
            }
        }
    }
}

component ProfileListItem inherits Rectangle {
    in property <ProfileRow> profile;
    in property <int> item-index;
    in property <int> last-enabled-index: -1;
    in property <bool> interactive: true;
    in-out property <bool> editing: false;
    callback selected(int);
    callback rename(int, string);
    callback hide(int);
    height: profile.visible ? 42px : 0px;
    visible: profile.visible;
    opacity: profile.enabled ? 1.0 : 0.55;
    border-radius: Theme.radius;
    border-width: profile.active ? 2px : 1px;
    border-color: profile.active ? Theme.accent : Theme.border;
    background: profile.active ? Theme.accent-soft : row-area.has-hover ? Theme.surface-raised : Theme.surface;

    row-area := TouchArea {
        x: 0px; y: 0px; width: parent.width - 76px; height: parent.height;
        enabled: root.profile.enabled && root.interactive && !root.editing;
        accessible-role: button;
        accessible-label: "select profile " + root.profile.name;
        accessible-action-default => { root.selected(root.item-index); }
        mouse-cursor: root.profile.enabled && root.interactive && !root.editing ? pointer : default;
        clicked => { root.selected(root.item-index); }
    }
    if root.profile.enabled && !root.editing : Text {
        x: 12px; y: 0px; width: parent.width - 90px; height: parent.height;
        text: root.profile.name; color: Theme.text; font-size: 11px; font-weight: root.profile.active ? 700 : 600;
        vertical-alignment: center; overflow: elide;
    }
    if !root.profile.enabled : Text {
        x: 12px; y: 0px; width: parent.width - 24px; height: parent.height;
        text: root.profile.name; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide;
    }
    if root.profile.enabled && root.editing : InputField {
        x: 8px; y: 4px; width: parent.width - 78px; height: 34px;
        text: root.profile.name; interactive: root.interactive;
        accepted(text) => { root.rename(root.item-index, text); root.editing = false; }
    }
    if root.profile.enabled && !root.editing : Rectangle {
        x: parent.width - (root.item-index == root.last-enabled-index && root.last-enabled-index > 0 ? 68px : 36px);
        y: 5px; width: 30px; height: 30px; border-radius: Theme.radius;
        background: edit-area.has-hover ? Theme.surface-raised : transparent;
        Text { text: "✎"; color: Theme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
        edit-area := TouchArea {
            enabled: root.interactive;
            accessible-role: button; accessible-label: "rename " + root.profile.name;
            accessible-action-default => { root.editing = true; }
            mouse-cursor: root.interactive ? pointer : default;
            clicked => { root.editing = true; }
        }
    }
    if root.profile.enabled && root.item-index == root.last-enabled-index && root.last-enabled-index > 0 : Rectangle {
        x: parent.width - 34px; y: 5px; width: 30px; height: 30px; border-radius: Theme.radius;
        background: hide-area.has-hover ? Theme.danger-soft : transparent;
        Text { text: "⊘"; color: Theme.danger; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
        hide-area := TouchArea {
            enabled: root.interactive;
            accessible-role: button; accessible-label: "hide " + root.profile.name;
            accessible-action-default => { root.hide(root.item-index); }
            mouse-cursor: root.interactive ? pointer : default;
            clicked => { root.hide(root.item-index); }
        }
    }
}

component ProfilePanel inherits Card {
    in property <[ProfileRow]> profiles;
    in property <int> last-enabled-index: -1;
    in property <bool> interactive: true;
    callback select-profile(int);
    callback add-profile;
    callback rename-profile(int, string);
    callback hide-profile(int);
    height: 214px;

    Text { x: 12px; y: 9px; text: "profiles"; color: Theme.text; font-size: 12px; font-weight: 700; }
    ScrollView {
        x: Theme.space-2; y: 28px; width: parent.width - Theme.space-4; height: parent.height - 64px;
        VerticalLayout {
            width: parent.width;
            spacing: Theme.space-1;
            for profile[index] in root.profiles : ProfileListItem {
                profile: profile;
                item-index: index;
                last-enabled-index: root.last-enabled-index;
                interactive: root.interactive;
                selected(index) => { root.select-profile(index); }
                rename(index, name) => { root.rename-profile(index, name); }
                hide(index) => { root.hide-profile(index); }
            }
        }
    }
    ActionButton {
        x: 10px; y: parent.height - 32px; width: parent.width - 20px; height: 26px;
        label: "add profile"; compact: true; enabled: root.interactive;
        clicked => { root.add-profile(); }
    }
}

component BindingActionDropdown inherits Rectangle {
    in property <string> current-value;
    in property <[string]> actions;
    in property <bool> interactive: true;
    in property <bool> popup-above: false;
    callback selected(string);
    height: 38px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: action-area.has-hover ? Theme.accent : Theme.border;
    background: action-area.has-hover ? Theme.surface-raised : Theme.surface;
    opacity: root.interactive ? 1.0 : 0.48;
    accessible-role: combobox;
    accessible-label: "button action, " + root.current-value;
    accessible-action-default => { if (root.interactive) { action-popup.show(); } }

    Text {
        x: Theme.space-3; y: 0px; width: parent.width - 34px; height: parent.height;
        text: root.current-value; color: Theme.text; font-size: 11px; font-weight: 600;
        vertical-alignment: center; overflow: elide;
    }
    Text {
        x: parent.width - 26px; y: 0px; width: 16px; height: parent.height;
        text: "⌄"; color: Theme.muted; font-size: 14px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    action-area := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { action-popup.show(); }
    }
    action-popup := PopupWindow {
        x: 0px; y: root.popup-above ? -self.height - Theme.space-1 : root.height + Theme.space-1;
        width: root.width; height: 264px;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.shadow;
            ScrollView {
                x: Theme.space-1; y: Theme.space-1;
                width: parent.width - 2 * Theme.space-1;
                height: parent.height - 2 * Theme.space-1;
                VerticalLayout {
                    width: parent.width;
                    spacing: 0px;
                    for action[index] in root.actions : Rectangle {
                        height: 32px;
                        border-radius: Theme.radius;
                        background: action == root.current-value ? Theme.accent-soft : option-area.has-hover ? Theme.surface-raised : Theme.surface;
                        Text {
                            x: Theme.space-2; y: 0px; width: parent.width - 2 * Theme.space-2; height: parent.height;
                            text: action; color: Theme.text; font-size: 11px;
                            font-weight: action == root.current-value ? 700 : 500;
                            vertical-alignment: center; overflow: elide;
                        }
                        option-area := TouchArea {
                            accessible-role: button;
                            accessible-label: "assign " + action;
                            accessible-action-default => { root.selected(action); action-popup.close(); }
                            mouse-cursor: pointer;
                            clicked => { root.selected(action); action-popup.close(); }
                        }
                    }
                }
            }
        }
    }
}

component MouseConnector inherits Rectangle {
    in property <length> from-x;
    in property <length> from-y;
    in property <length> to-x;
    in property <length> to-y;
    x: root.from-x;
    y: min(root.from-y, root.to-y);
    width: root.to-x - root.from-x;
    height: max(root.from-y, root.to-y) - root.y + 1px;
    background: transparent;
    Rectangle {
        x: 0px; y: root.from-y - root.y;
        width: parent.width - Theme.space-4; height: 1px;
        background: Theme.border;
    }
    Rectangle {
        x: parent.width - Theme.space-4; y: min(root.from-y, root.to-y) - root.y;
        width: 1px; height: max(1px, max(root.from-y, root.to-y) - min(root.from-y, root.to-y));
        background: Theme.border;
    }
    Rectangle {
        x: parent.width - Theme.space-4; y: root.to-y - root.y;
        width: Theme.space-4; height: 1px;
        background: Theme.border;
    }
    Rectangle {
        x: -4px; y: root.from-y - root.y - 4px;
        width: 8px; height: 8px; border-radius: 4px;
        background: Theme.accent;
    }
}

component BindingCard inherits Rectangle {
    in property <BindingRow> item;
    in property <int> item-index;
    in property <[string]> actions;
    in property <bool> interactive: true;
    callback action-selected(int, string);
    height: 54px;
    background: transparent;
    Text { x: 0px; y: 3px; width: 116px; text: root.item.button; color: Theme.text; font-size: 11px; font-weight: 700; overflow: elide; }
    Text { x: 0px; y: 24px; width: 116px; text: root.item.location; color: Theme.muted; font-size: 9px; overflow: elide; }
    accessible-role: groupbox;
    accessible-label: root.item.button + " assignment";
    BindingActionDropdown {
        x: 124px; y: 7px; width: parent.width - 124px;
        actions: root.actions;
        current-value: root.item.action;
        popup-above: root.item-index >= 4;
        interactive: root.interactive && root.item.editable;
        selected(value) => { root.action-selected(root.item-index, value); }
    }
}

component DpiStageRow inherits Rectangle {
    in property <DpiStage> stage;
    in property <int> item-index;
    in property <bool> interactive: false;
    in property <bool> can-remove: true;
    in property <string> range-min;
    in property <string> range-max;
    callback clicked(int);
    callback dragged(int, float);
    callback remove(int);
    height: 64px;
    border-radius: Theme.radius;
    border-width: stage.active ? 2px : 1px;
    border-color: stage.active ? stage.accent : Theme.border;
    background: stage.active ? Theme.accent-soft : root.interactive && row-area.has-hover ? Theme.surface-raised : Theme.surface;
    property <float> pointer-ratio: max(0.0, min(1.0, (track-area.mouse-x - 6px) / (track-area.width - 12px)));

    Rectangle { x: 10px; y: 10px; width: 5px; height: 22px; border-radius: 3px; background: stage.accent; }
    Text { x: 23px; y: 8px; width: 24px; text: stage.index; color: Theme.muted; font-size: 9px; font-weight: 700; }
    Text { x: 50px; y: 5px; width: 92px; text: stage.value + " dpi"; color: Theme.text; font-size: 13px; font-weight: 700; overflow: elide; }
    Text { x: 146px; y: 8px; width: parent.width - 246px; text: stage.active ? "active" : stage.label; color: stage.active ? Theme.accent : Theme.muted; font-size: 9px; overflow: elide; }
    Rectangle { x: 50px; y: 39px; width: parent.width - 64px; height: 2px; background: Theme.border; }
    Rectangle { x: 50px + (parent.width - 64px) * stage.ratio - 5px; y: 35px; width: 10px; height: 10px; border-radius: 5px; background: stage.active ? stage.accent : Theme.muted; }
    Text { x: 50px; y: 46px; width: 72px; text: root.range-min; color: Theme.muted; font-size: 8px; }
    Text { x: parent.width - 86px; y: 46px; width: 72px; text: root.range-max; color: Theme.muted; font-size: 8px; horizontal-alignment: right; }
    track-area := TouchArea {
        x: 42px; y: 29px; width: parent.width - 48px; height: 28px;
        enabled: root.interactive;
        accessible-role: button;
        accessible-label: "adjust DPI stage " + root.stage.index;
        accessible-action-default => { root.dragged(root.item-index, root.pointer-ratio); }
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.dragged(root.item-index, root.pointer-ratio); }
        moved => { if (track-area.pressed) { root.dragged(root.item-index, root.pointer-ratio); } }
    }
    if root.can-remove : ActionButton {
        x: parent.width - 94px; y: 5px; width: 82px; height: 28px;
        label: "remove"; compact: true; enabled: root.interactive;
        clicked => { root.remove(root.item-index); }
    }
    if !root.can-remove : Text { x: parent.width - 94px; y: 13px; width: 82px; text: "one required"; color: Theme.muted; font-size: 8px; horizontal-alignment: center; }
    row-area := TouchArea {
        x: 0px; y: 0px; width: parent.width - 98px; height: 29px; enabled: root.interactive;
        accessible-role: button;
        accessible-label: "select DPI stage " + root.stage.index;
        accessible-action-default => { root.clicked(root.item-index); }
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(root.item-index); }
    }
}

component OverviewPage inherits Rectangle {
    in property <string> battery-text;
    in property <string> device-name;
    in property <string> profile-summary;
    in property <string> active-dpi-text;
    in property <string> active-stage-text;
    in property <string> polling-rate-text;
    in property <string> verification-text;
    in property <bool> hardware-ready: false;
    in property <bool> all-profiles-observed: false;
    in property <bool> all-profiles-refresh-dismissed: false;
    in property <bool> ble-device: false;
    callback request-refresh-all-profiles;
    callback dismiss-all-profiles-refresh;
    callback navigate(int);
    background: transparent;

    SectionTitle { x: 24px; y: 20px; title: "overview"; subtitle: "Your mouse at a glance."; }
    Card {
        x: 24px; y: 88px; width: parent.width - 48px; height: 184px;
        Text { x: 20px; y: 18px; text: root.device-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
        Text { x: 20px; y: 50px; width: 340px; text: root.hardware-ready ? "ready to customize" : "connect your mouse"; color: Theme.text; font-size: 27px; font-weight: 700; }
        Text { x: 20px; y: 112px; width: 380px; text: root.profile-summary; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        if !root.battery-text.is-empty : Text { x: parent.width - 206px; y: 20px; width: 180px; text: "battery"; color: Theme.muted; font-size: 10px; horizontal-alignment: right; }
        if !root.battery-text.is-empty : Text { x: parent.width - 206px; y: 46px; width: 180px; text: root.battery-text; color: Theme.text; font-size: 25px; font-weight: 700; horizontal-alignment: right; overflow: elide; }
        Text { x: parent.width - 206px; y: 86px; width: 180px; text: root.verification-text; color: Theme.muted; font-size: 9px; horizontal-alignment: right; wrap: word-wrap;
            Tooltip {
                text: @markdown("What this means: applied — the mouse accepted the change; confirmed by the mouse — the mouse reported the setting; survives a full power-off — the setting stayed after reconnecting. Run a check in Advanced to raise the confidence.");
            }
        }
    }
    HorizontalLayout {
        x: 24px; y: 290px; width: parent.width - 48px; height: 104px; spacing: Theme.space-2;
        Card { Text { x: 14px; y: 14px; text: "active DPI"; color: Theme.muted; font-size: 10px; } Text { x: 14px; y: 38px; text: root.active-dpi-text; color: Theme.text; font-size: 19px; font-weight: 700; } Text { x: 14px; y: 76px; text: root.active-stage-text; color: Theme.muted; font-size: 9px; } }
        Card { Text { x: 14px; y: 14px; text: "polling rate"; color: Theme.muted; font-size: 10px; } Text { x: 14px; y: 38px; text: root.polling-rate-text; color: Theme.text; font-size: 19px; font-weight: 700; } Text { x: 14px; y: 76px; text: "current setting"; color: Theme.muted; font-size: 9px; } }
        Card { Text { x: 14px; y: 14px; text: "profile"; color: Theme.muted; font-size: 10px; } Text { x: 14px; y: 38px; text: root.profile-summary; color: Theme.text; font-size: 14px; font-weight: 700; overflow: elide; } Text { x: 14px; y: 76px; text: "currently selected"; color: Theme.muted; font-size: 9px; } }
    }
    if root.hardware-ready && !root.ble-device && !root.all-profiles-observed && !root.all-profiles-refresh-dismissed : Card {
        x: 24px; y: 408px; width: parent.width - 48px; height: 142px;
        Text { x: 18px; y: 14px; text: "read all profile slots"; color: Theme.text; font-size: 15px; font-weight: 700; }
        Text { x: 18px; y: 40px; width: parent.width - 36px; height: 46px; text: "The app hasn't read every profile yet. This reads all five slots, then restores your current profile and enabled count."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
        ActionButton { x: 18px; y: 98px; width: 138px; label: "read all profiles"; primary: true; compact: true; clicked => { root.request-refresh-all-profiles(); } }
        ActionButton { x: 164px; y: 98px; width: 84px; label: "not now"; compact: true; clicked => { root.dismiss-all-profiles-refresh(); } }
    }
}

component ButtonsPage inherits Rectangle {
    in property <[BindingRow]> bindings;
    in property <[string]> binding-actions;
    in property <bool> interactive: false;
    callback set-binding-action(int, string);
    background: transparent;

    SectionTitle { x: 24px; y: 20px; title: "buttons"; subtitle: "Choose what each physical button does."; }
    assignments-card := Card {
        x: 24px; y: 88px; width: parent.width - 48px; height: parent.height - 106px;
        property <length> mouse-box-height: self.height - 76px;
        property <length> mouse-render-height: min(self.mouse-box-height, 280px * 1104.0 / 606.0);
        property <length> mouse-render-width: self.mouse-render-height * 606.0 / 1104.0;
        property <length> mouse-left: 34px + (280px - self.mouse-render-width) / 2;
        property <length> mouse-top: 52px + (self.mouse-box-height - self.mouse-render-height) / 2;
        Text { x: 18px; y: 14px; text: root.interactive ? "Button assignments" : "Connect your mouse to change button assignments."; color: root.interactive ? Theme.muted : Theme.warning; font-size: 10px; }
        Image {
            x: assignments-card.mouse-left; y: assignments-card.mouse-top;
            width: assignments-card.mouse-render-width; height: assignments-card.mouse-render-height;
            source: @image-url("../assets/mouse-top.png"); image-fit: contain;
        }

        left-click-connector := MouseConnector {
            from-x: assignments-card.mouse-left + assignments-card.mouse-render-width * 0.36;
            from-y: assignments-card.mouse-top + assignments-card.mouse-render-height * 0.15;
            to-x: 366px; to-y: 77px;
        }
        right-click-connector := MouseConnector {
            from-x: assignments-card.mouse-left + assignments-card.mouse-render-width * 0.68;
            from-y: assignments-card.mouse-top + assignments-card.mouse-render-height * 0.15;
            to-x: 366px; to-y: 131px;
        }
        wheel-connector := MouseConnector {
            from-x: assignments-card.mouse-left + assignments-card.mouse-render-width * 0.51;
            from-y: assignments-card.mouse-top + assignments-card.mouse-render-height * 0.19;
            to-x: 366px; to-y: 185px;
        }
        dpi-connector := MouseConnector {
            from-x: assignments-card.mouse-left + assignments-card.mouse-render-width * 0.515;
            from-y: assignments-card.mouse-top + assignments-card.mouse-render-height * 0.36;
            to-x: 366px; to-y: 239px;
        }
        forward-side-connector := MouseConnector {
            from-x: assignments-card.mouse-left + assignments-card.mouse-render-width * 0.085;
            from-y: assignments-card.mouse-top + assignments-card.mouse-render-height * 0.35;
            to-x: 366px; to-y: 293px;
        }
        back-side-connector := MouseConnector {
            from-x: assignments-card.mouse-left + assignments-card.mouse-render-width * 0.085;
            from-y: assignments-card.mouse-top + assignments-card.mouse-render-height * 0.51;
            to-x: 366px; to-y: 347px;
        }

        VerticalLayout {
            x: 374px; y: 50px; width: parent.width - 392px; height: 330px; spacing: 0px;
            for item[index] in root.bindings : BindingCard {
                item: item; item-index: index; actions: root.binding-actions; interactive: root.interactive;
                action-selected(item-index, action) => { root.set-binding-action(item-index, action); }
            }
        }
    }
}

component SensitivityPage inherits Rectangle {
    in property <[DpiStage]> dpi-stages;
    in property <float> dpi-min;
    in property <float> dpi-max;
    in property <bool> interactive: false;
    in-out property <bool> motion-sync-readback: false;
    in-out property <bool> ripple-control-readback: false;
    in-out property <bool> angle-snap: false;
    in-out property <int> lift-off-choice: 0;
    callback select-dpi(int);
    callback drag-dpi(int, float);
    callback add-dpi-stage;
    callback remove-dpi-stage(int);
    callback open-settings;
    callback toggle-motion-sync(bool);
    callback toggle-ripple-control(bool);
    callback toggle-angle-snap(bool);
    callback set-lift-off(int);
    background: transparent;
    property <length> columns-height: max(462px, 78px + root.dpi-stages.length * 68px);

    SectionTitle { x: 24px; y: 20px; title: "sensitivity"; subtitle: "Fine-tune pointer speed and sensor behavior."; }
    ScrollView {
        x: 24px; y: 88px; width: parent.width - 48px; height: parent.height - 106px;
        VerticalLayout {
            width: parent.width;
            spacing: Theme.space-3;
            HorizontalLayout {
                width: parent.width; height: root.columns-height; spacing: Theme.space-3;
                Card {
                    min-width: 430px; height: root.columns-height;
                    Text { x: 16px; y: 14px; text: "DPI stages"; color: Theme.text; font-size: 14px; font-weight: 700; }
                    Text { x: 16px; y: 36px; width: parent.width - 146px; text: "Select or drag a stage."; color: Theme.muted; font-size: 9px; }
                    ActionButton { x: parent.width - 122px; y: 10px; width: 106px; label: "add stage"; compact: true; enabled: root.interactive && root.dpi-stages.length < 8; clicked => { root.add-dpi-stage(); } }
                    VerticalLayout {
                        x: 10px; y: 66px; width: parent.width - 20px; height: parent.height - 76px; spacing: Theme.space-1;
                        for stage[index] in root.dpi-stages : DpiStageRow {
                            stage: stage; item-index: index; interactive: root.interactive; can-remove: root.dpi-stages.length > 1;
                            range-min: "\{round(root.dpi-min)}"; range-max: "\{round(root.dpi-max)}";
                            clicked(item-index) => { root.select-dpi(item-index); }
                            dragged(item-index, ratio) => { root.drag-dpi(item-index, ratio); }
                            remove(item-index) => { root.remove-dpi-stage(item-index); }
                        }
                    }
                }
                VerticalLayout {
                    min-width: 318px; max-width: 318px; height: 462px; spacing: Theme.space-3;
                    Card {
                        height: 64px;
                        Text { x: 16px; y: 10px; text: "DPI display range"; color: Theme.text; font-size: 12px; font-weight: 700; }
                        Text { x: 16px; y: 32px; width: parent.width - 174px; text: "Configured in App Settings."; color: Theme.muted; font-size: 9px; overflow: elide; }
                        ActionButton { x: parent.width - 142px; y: 15px; width: 126px; label: "app settings"; primary: true; compact: true; clicked => { root.open-settings(); } }
                    }
                    Card {
                        height: 386px;
                        Text { x: 16px; y: 14px; text: "sensor behavior"; color: Theme.text; font-size: 14px; font-weight: 700; }
                        Text { x: 16px; y: 36px; width: parent.width - 32px; text: root.interactive ? "Tune how movement is reported." : "Connect your mouse to edit."; color: root.interactive ? Theme.muted : Theme.warning; font-size: 9px; overflow: elide; }
                        ToggleRow { x: 16px; y: 56px; width: parent.width - 32px; label: "motion sync"; detail: "Align reports with sensor capture timing."; checked <=> root.motion-sync-readback; interactive: root.interactive; toggled(value) => { root.toggle-motion-sync(value); } }
                        Rectangle { x: 16px; y: 120px; width: parent.width - 32px; height: 1px; background: Theme.border; }
                        ToggleRow { x: 16px; y: 124px; width: parent.width - 32px; label: "ripple control"; detail: "Smooth tiny movements at high DPI."; checked <=> root.ripple-control-readback; interactive: root.interactive; toggled(value) => { root.toggle-ripple-control(value); } }
                        Rectangle { x: 16px; y: 188px; width: parent.width - 32px; height: 1px; background: Theme.border; }
                        ToggleRow { x: 16px; y: 192px; width: parent.width - 32px; label: "angle snapping"; detail: "Straighten near-axis movement."; checked <=> root.angle-snap; interactive: root.interactive; toggled(value) => { root.toggle-angle-snap(value); } }
                        Rectangle { x: 16px; y: 256px; width: parent.width - 32px; height: 1px; background: Theme.border; }
                        Text { x: 16px; y: 270px; text: "lift-off distance"; color: Theme.text; font-size: 12px; font-weight: 650; }
                        Text { x: 16px; y: 294px; width: parent.width - 32px; text: "Stop tracking sooner or later when lifted."; color: Theme.muted; font-size: 9px; overflow: elide; }
                        HorizontalLayout { x: 16px; y: 326px; width: parent.width - 32px; height: 34px; spacing: Theme.space-2;
                            ChoiceButton { label: "1 mm"; compact: true; selected: root.lift-off-choice == 0; enabled: root.interactive; clicked => { root.lift-off-choice = 0; root.set-lift-off(0); } }
                            ChoiceButton { label: "2 mm"; compact: true; selected: root.lift-off-choice == 1; enabled: root.interactive; clicked => { root.lift-off-choice = 1; root.set-lift-off(1); } }
                        }
                    }
                }
            }
        }
    }
}

component PerformancePage inherits Rectangle {
    in-out property <int> selected-rate-hz: 1000;
    in property <bool> interactive: false;
    in property <bool> rate-interactive: false;
    in property <bool> baseline-ready: false;
    in property <bool> ble-device: false;
    in-out property <int> debounce-ms: 8;
    in-out property <int> sleep-half-minutes: 2;
    in-out property <int> deep-sleep-minutes: 60;
    in property <bool> deep-sleep-known: false;
    callback rate-changed(int);
    callback set-debounce-ms(int);
    callback set-sleep-half-minutes(int);
    callback set-deep-sleep-minutes(int);
    callback set-debounce-text(string);
    callback set-sleep-text(string);
    callback set-deep-sleep-text(string);

    SectionTitle { x: 24px; y: 20px; title: "performance"; subtitle: "Balance responsiveness with battery life."; }
    ScrollView {
        x: 24px; y: 88px; width: parent.width - 48px; height: parent.height - 106px;
        VerticalLayout {
            width: parent.width; spacing: Theme.space-3;
            Card {
                width: parent.width; height: 166px;
                Text { x: 18px; y: 16px; text: "polling rate"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 41px; width: parent.width - 36px; text: root.ble-device ? "Connect by USB to change the polling rate." : "Higher rates feel more responsive and use more power."; color: root.ble-device ? Theme.warning : Theme.muted; font-size: 10px; }
                HorizontalLayout { x: 18px; y: 76px; width: parent.width - 36px; height: 54px; spacing: Theme.space-2;
                    ChoiceButton { label: "125"; detail: "Hz"; selected: root.selected-rate-hz == 125; enabled: root.rate-interactive; clicked => { root.selected-rate-hz = 125; root.rate-changed(125); } }
                    ChoiceButton { label: "250"; detail: "Hz"; selected: root.selected-rate-hz == 250; enabled: root.rate-interactive; clicked => { root.selected-rate-hz = 250; root.rate-changed(250); } }
                    ChoiceButton { label: "500"; detail: "Hz"; selected: root.selected-rate-hz == 500; enabled: root.rate-interactive; clicked => { root.selected-rate-hz = 500; root.rate-changed(500); } }
                    ChoiceButton { label: "1000"; detail: "Hz"; selected: root.selected-rate-hz == 1000; enabled: root.rate-interactive; clicked => { root.selected-rate-hz = 1000; root.rate-changed(1000); } }
                }
            }
            Card {
                width: parent.width; height: 140px;
                Text { x: 18px; y: 16px; text: "click debounce"; color: Theme.text; font-size: 14px; font-weight: 700; }
                Text { x: 18px; y: 40px; text: "Lower values respond faster; higher values filter switch bounce."; color: Theme.muted; font-size: 10px; }
                ThemedSlider {
                    x: 18px; y: 64px; width: parent.width - 178px;
                    minimum: 4; maximum: 50; step: 2; value: root.debounce-ms; enabled: root.interactive;
                    accessible-name: "click debounce"; minimum-label: "4 ms"; maximum-label: "50 ms";
                    changed(value) => { root.set-debounce-ms(round(value / 2) * 2); }
                }
                InputField { x: parent.width - 144px; y: 68px; width: 82px; text: "\{root.debounce-ms}"; interactive: root.interactive; accepted(value) => { root.set-debounce-text(value); } }
                Text { x: parent.width - 54px; y: 68px; height: Theme.control-height; text: "ms"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
            }
            power-card := Card {
                width: parent.width; height: 174px;
                Rectangle {
                    x: 18px; y: 0px; width: (power-card.width - 54px) / 2; height: parent.height; background: transparent;
                    Text { y: 16px; text: "sleep timer"; color: Theme.text; font-size: 14px; font-weight: 700; }
                    Text { y: 40px; width: parent.width; text: "First power-saving delay."; color: Theme.muted; font-size: 10px; }
                    ThemedSlider {
                        x: 0px; y: 64px; width: parent.width - 100px;
                        minimum: 1; maximum: 60; step: 1; value: root.sleep-half-minutes; enabled: root.interactive;
                        accessible-name: "sleep timer"; minimum-label: "0.5 min"; maximum-label: "30 min";
                        changed(value) => { root.set-sleep-half-minutes(round(value)); }
                    }
                    InputField { x: parent.width - 90px; y: 68px; width: 56px; text: "\{root.sleep-half-minutes * 0.5}"; interactive: root.interactive; accepted(value) => { root.set-sleep-text(value); } }
                    Text { x: parent.width - 28px; y: 68px; height: Theme.control-height; text: "min"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                }
                Rectangle { x: parent.width / 2; y: Theme.space-4; width: 1px; height: parent.height - Theme.space-5 - Theme.space-3; background: Theme.border; }
                Rectangle {
                    x: parent.width / 2 + 18px; y: 0px; width: (power-card.width - 54px) / 2; height: parent.height; background: transparent;
                    Text { y: 16px; text: "deep sleep"; color: Theme.text; font-size: 14px; font-weight: 700; }
                    Text { y: 40px; width: parent.width; text: "Whole-minute power-off delay."; color: Theme.muted; font-size: 10px; }
                    ThemedSlider {
                        x: 0px; y: 64px; width: parent.width - 100px;
                        minimum: 1; maximum: 60; step: 1; value: root.deep-sleep-minutes; enabled: root.interactive && root.deep-sleep-known;
                        accessible-name: "deep sleep timer"; minimum-label: "1 min"; maximum-label: "60 min";
                        changed(value) => { root.set-deep-sleep-minutes(round(value)); }
                    }
                    InputField { x: parent.width - 90px; y: 68px; width: 56px; text: "\{root.deep-sleep-minutes}"; interactive: root.interactive && root.deep-sleep-known; accepted(value) => { root.set-deep-sleep-text(value); } }
                    Text { x: parent.width - 28px; y: 68px; height: Theme.control-height; text: "min"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                    if !root.deep-sleep-known : Text { x: 0px; y: 136px; width: parent.width; text: "Reconnect the mouse to load this setting."; color: Theme.warning; font-size: 9px; }
                }
            }
        }
    }
}

component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 42px;
    background: transparent;
    Text { x: 0px; height: parent.height; text: root.label; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
    Text { x: 142px; width: parent.width - 142px; height: parent.height; text: root.value; color: Theme.text; font-size: 11px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
}

component AdvancedPage inherits Rectangle {
    in property <[DeviceRow]> devices;
    in property <[UnassociatedRow]> unassociated;
    in property <string> transport-label;
    in property <string> device-name;
    in property <string> device-id-text;
    in property <string> device-product-text;
    in property <string> metadata-summary;
    in property <string> lifecycle-text;
    in property <int> validation-choice;
    in property <bool> all-profiles-observed: false;
    callback request-refresh-all-profiles;
    in property <bool> interactive: false;
    in property <bool> preferences-ready: false;
    in property <bool> ble-device: false;
    in-out property <int> baseline-choice-wired: 0;
    in-out property <int> baseline-choice-receiver: 1;
    in-out property <bool> allow-explicit-defaults: false;
    in-out property <bool> advanced-preferences: false;
    in-out property <string> preference-configuration-raw;
    in-out property <string> preference-deep-sleep-raw;
    in-out property <string> preference-sleep-timer-raw;
    in-out property <string> preference-debounce-raw;
    in property <string> verification-instruction;
    in property <bool> verification-running: false;
    in property <bool> ceremony-active: false;
    callback set-validation-choice(int);
    callback set-baseline-choice-wired(int);
    callback set-baseline-choice-receiver(int);
    callback set-allow-explicit-defaults(bool);
    callback toggle-advanced-preferences;
    callback set-preference-raw(int, string);
    callback request-import;
    callback request-export;
    callback request-invalidate-state;
    callback request-verify-profile;
    callback request-verify-power-cycle;
    callback request-add-mouse;
    callback unassociated-action(int, int);
    callback show-ceremony;

    SectionTitle { x: 24px; y: 20px; title: "advanced"; subtitle: "Connection details, device checks, and recovery tools."; }
    ScrollView {
        x: 24px; y: 88px; width: parent.width - 48px; height: parent.height - 106px;
        VerticalLayout {
            width: parent.width;
            spacing: 12px;
            Card {
                width: parent.width; height: 184px;
                Text { x: 18px; y: 15px; text: "connection details"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; text: root.device-name; color: Theme.text; font-size: 12px; font-weight: 650; overflow: elide; }
                Text { x: 18px; y: 64px; text: root.transport-label; color: Theme.muted; font-size: 10px; }
                VerticalLayout { x: 18px; y: 88px; width: parent.width - 36px; height: 80px;
                    DetailRow { label: "stable id"; value: root.device-id-text; }
                    DetailRow { label: "vendor:product"; value: root.device-product-text; }
                }
            }
            Card {
                width: parent.width; height: 170px;
                Text { x: 18px; y: 15px; text: "save checks"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; width: parent.width - 36px; text: root.ble-device ? "The mouse can acknowledge Bluetooth changes but can't confirm the settings." : "Choose how confidently the app confirms USB changes."; color: root.ble-device ? Theme.warning : Theme.muted; font-size: 10px; wrap: word-wrap; }
                HorizontalLayout { x: 18px; y: 82px; width: 260px; height: 38px; spacing: 6px;
                    ChoiceButton { label: "device acknowledged"; compact: true; selected: root.validation-choice == 0; enabled: root.interactive; clicked => { root.set-validation-choice(0); } }
                    ChoiceButton { label: "confirmed by mouse"; compact: true; selected: root.validation-choice == 1; enabled: root.interactive && !root.ble-device; clicked => { root.set-validation-choice(1); } }
                }
                Text { x: 294px; y: 87px; width: parent.width - 314px; text: root.validation-choice == 1 && !root.ble-device ? "confirmed by the mouse" : "applied (device acknowledged)"; color: Theme.text; font-size: 11px; font-weight: 650; }
                Text { x: 18px; y: 137px; text: root.lifecycle-text; color: Theme.muted; font-size: 9px; overflow: elide; }
            }
            Card {
                width: parent.width; height: 210px;
                Text { x: 18px; y: 15px; text: "configuration source"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; width: parent.width - 36px; text: "USB defaults to the mouse, dongle defaults to saved. BLE always uses saved."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
                Text { x: 18px; y: 68px; text: "USB (wired)"; color: Theme.text; font-size: 11px; font-weight: 600; }
                HorizontalLayout { x: 18px; y: 86px; width: 230px; height: 38px; spacing: 6px;
                    ChoiceButton { label: "from mouse"; compact: true; selected: root.baseline-choice-wired == 0; enabled: root.interactive && !root.ble-device; clicked => { root.baseline-choice-wired = 0; root.set-baseline-choice-wired(0); } }
                    ChoiceButton { label: "saved"; compact: true; selected: root.baseline-choice-wired == 1; enabled: root.interactive; clicked => { root.baseline-choice-wired = 1; root.set-baseline-choice-wired(1); } }
                }
                Text { x: 18px; y: 132px; text: "2.4G receiver (dongle)"; color: Theme.text; font-size: 11px; font-weight: 600; }
                HorizontalLayout { x: 18px; y: 150px; width: 230px; height: 38px; spacing: 6px;
                    ChoiceButton { label: "from mouse"; compact: true; selected: root.baseline-choice-receiver == 0; enabled: root.interactive; clicked => { root.baseline-choice-receiver = 0; root.set-baseline-choice-receiver(0); } }
                    ChoiceButton { label: "saved"; compact: true; selected: root.baseline-choice-receiver == 1; enabled: root.interactive; clicked => { root.baseline-choice-receiver = 1; root.set-baseline-choice-receiver(1); } }
                }
                ToggleRow { x: 276px; y: 88px; width: parent.width - 294px; label: "use defaults if needed"; detail: "Use only when no saved or connected configuration is available."; checked <=> root.allow-explicit-defaults; interactive: root.interactive; toggled(value) => { root.set-allow-explicit-defaults(value); } }
            }
            Card {
                width: parent.width; height: root.advanced-preferences ? 330px : 98px;
                Text { x: 18px; y: 15px; text: "technical preference fields"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; width: parent.width - 190px; text: "For diagnosis and recovery. Leave collapsed during normal use."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
                ActionButton { x: parent.width - 164px; y: 16px; width: 146px; label: root.advanced-preferences ? "hide fields" : "show fields"; compact: true; enabled: root.interactive; clicked => { root.toggle-advanced-preferences(); } }
                if root.advanced-preferences : VerticalLayout {
                    x: 18px; y: 86px; width: parent.width - 36px; height: 226px; spacing: 8px;
                    Rectangle { height: 44px; background: transparent; Text { x: 0px; y: 0px; width: 150px; text: "configuration"; color: Theme.text; font-size: 10px; vertical-alignment: center; } InputField { x: 160px; y: 5px; width: parent.width - 160px; height: 34px; text <=> root.preference-configuration-raw; interactive: root.interactive; accepted(value) => { root.set-preference-raw(0, value); } } }
                    Rectangle { height: 44px; background: transparent; Text { x: 0px; y: 0px; width: 150px; text: "deep sleep"; color: Theme.text; font-size: 10px; vertical-alignment: center; } InputField { x: 160px; y: 5px; width: parent.width - 160px; height: 34px; text <=> root.preference-deep-sleep-raw; interactive: root.interactive; accepted(value) => { root.set-preference-raw(1, value); } } }
                    Rectangle { height: 44px; background: transparent; Text { x: 0px; y: 0px; width: 150px; text: "sleep timer"; color: Theme.text; font-size: 10px; vertical-alignment: center; } InputField { x: 160px; y: 5px; width: parent.width - 160px; height: 34px; text <=> root.preference-sleep-timer-raw; interactive: root.interactive; accepted(value) => { root.set-preference-raw(2, value); } } }
                    Rectangle { height: 44px; background: transparent; Text { x: 0px; y: 0px; width: 150px; text: "debounce"; color: Theme.text; font-size: 10px; vertical-alignment: center; } InputField { x: 160px; y: 5px; width: parent.width - 160px; height: 34px; text <=> root.preference-debounce-raw; interactive: root.interactive; accepted(value) => { root.set-preference-raw(3, value); } } }
                }
            }
            Card {
                width: parent.width; height: 184px;
                Text { x: 18px; y: 15px; text: "profile readings"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; width: parent.width - 36px; height: 58px; text: root.ble-device ? "Reading profiles needs USB; unavailable over BLE." : root.all-profiles-observed ? "All five profiles have been read." : "Re-read all five profiles without replacing your saved settings."; color: root.ble-device ? Theme.warning : Theme.muted; font-size: 10px; wrap: word-wrap; }
                ActionButton { x: 18px; y: 116px; width: 194px; label: "read all profiles"; compact: true; enabled: root.interactive && !root.ble-device; clicked => { root.request-refresh-all-profiles(); } }
            }
            Card {
                width: parent.width; height: 116px;
                Text { x: 18px; y: 15px; text: "backup and recovery"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; text: "Import or export a backup, or reset stale local data."; color: Theme.muted; font-size: 10px; }
                HorizontalLayout { x: 18px; y: 68px; width: 360px; height: 34px; spacing: 6px;
                    ActionButton { label: "import"; compact: true; enabled: !root.verification-running; clicked => { root.request-import(); } }
                    ActionButton { label: "export"; compact: true; enabled: !root.verification-running; clicked => { root.request-export(); } }
                    ActionButton { label: "clear saved status"; compact: true; destructive: true; enabled: !root.verification-running; clicked => { root.request-invalidate-state(); } }
                }
            }
            Card {
                width: parent.width; height: 148px + root.unassociated.length * 68px;
                Text { x: 18px; y: 15px; text: "mouse identity"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; width: parent.width - 36px; text: "Add another mouse to tell your mice apart. Unrecognized connections below can be restored, added, adopted, or paired."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
                ActionButton { x: 18px; y: 80px; width: 176px; label: "add another mouse"; primary: true; compact: true; enabled: root.interactive && !root.ceremony-active; clicked => { root.request-add-mouse(); } }
                if root.ceremony-active : ActionButton { x: 204px; y: 80px; width: 120px; label: "show setup"; compact: true; clicked => { root.show-ceremony(); } }
                Rectangle { x: 18px; y: 126px; width: parent.width - 36px; height: 1px; background: Theme.border; }
                if root.unassociated.length == 0 : Text { x: 18px; y: 138px; width: parent.width - 36px; text: "Every connection is recognized."; color: Theme.muted; font-size: 10px; }
                VerticalLayout {
                    x: 18px; y: 136px; width: parent.width - 36px; height: root.unassociated.length * 68px; spacing: 8px;
                    for connection[index] in root.unassociated : Rectangle {
                        height: 60px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface-raised;
                        Text { x: 12px; y: 6px; width: parent.width - 24px; height: 16px; text: connection.name; color: Theme.text; font-size: 11px; font-weight: 650; overflow: elide; }
                        Text { x: 12px; y: 24px; width: parent.width - 24px; height: 14px; text: connection.detail; color: Theme.muted; font-size: 9px; overflow: elide; }
                        HorizontalLayout {
                            x: 12px; y: 40px; width: parent.width - 24px; height: 26px; spacing: 6px;
                            if connection.can-restore : ActionButton { label: "restore a saved mouse"; compact: true; height: 26px; enabled: root.interactive && !root.ceremony-active; clicked => { root.unassociated-action(index, 1); } }
                            if connection.can-add : ActionButton { label: "add as a different mouse"; compact: true; height: 26px; enabled: root.interactive && !root.ceremony-active; clicked => { root.unassociated-action(index, 0); } }
                            if connection.can-adopt : ActionButton { label: "adopt this mouse"; compact: true; height: 26px; enabled: root.interactive && !root.ceremony-active; clicked => { root.unassociated-action(index, 2); } }
                            if connection.can-associate : ActionButton { label: "pair with a saved mouse"; compact: true; height: 26px; enabled: root.interactive && !root.ceremony-active; clicked => { root.unassociated-action(index, 3); } }
                        }
                    }
                }
            }
            Card {
                width: parent.width; height: 178px;
                Text { x: 18px; y: 15px; text: "device checks"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 40px; width: parent.width - 36px; text: "Reload the profile to check saved settings. A power-cycle check asks you to disconnect and reconnect the mouse."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
                Rectangle { x: 18px; y: 84px; width: parent.width - 36px; height: 36px; border-radius: Theme.radius; background: root.verification-running ? Theme.accent-soft : Theme.surface-raised; }
                Text { x: 30px; y: 84px; width: parent.width - 60px; height: 36px; text: root.verification-running ? root.verification-instruction : "No check is running. Read the instructions above first."; color: root.verification-running ? Theme.accent : Theme.muted; font-size: 9px; vertical-alignment: center; wrap: word-wrap; }
                ActionButton { x: 18px; y: 132px; width: 152px; label: "verify profile reload"; compact: true; enabled: root.interactive && !root.verification-running; clicked => { root.request-verify-profile(); } }
                ActionButton { x: 180px; y: 132px; width: 162px; label: "verify power cycle"; compact: true; enabled: root.interactive && !root.verification-running; clicked => { root.request-verify-power-cycle(); } }
            }
        }
    }
}

component SettingsPage inherits Rectangle {
    in property <int> product-name-choice;
    in-out property <string> custom-product-name;
    in property <bool> logarithmic-scale;
    in property <float> dpi-min;
    in property <float> dpi-max;
    in-out property <string> dpi-min-text;
    in-out property <string> dpi-max-text;
    callback select-product-name(int);
    callback custom-name-changed(string);
    callback select-appearance(int);
    callback toggle-dpi-scale;
    callback apply-dpi-range(string, string);

    SectionTitle { x: 24px; y: 18px; title: "app settings"; subtitle: "Personalize the app and its DPI display."; }
    ScrollView {
        x: 24px; y: 88px; width: parent.width - 48px; height: parent.height - 106px;
        VerticalLayout {
            width: parent.width; spacing: Theme.space-3;
            Card {
                width: parent.width; height: 142px;
                Text { x: 18px; y: 14px; text: "DPI scale and range"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 38px; width: parent.width - 36px; text: "Controls how DPI stages are spaced in the Sensitivity visualization."; color: Theme.muted; font-size: 9px; overflow: elide; }
                ActionButton { x: 18px; y: 66px; width: 142px; label: root.logarithmic-scale ? "logarithmic scale" : "linear scale"; compact: true; clicked => { root.toggle-dpi-scale(); } }
                Text { x: 176px; y: 56px; text: "minimum"; color: Theme.muted; font-size: 9px; }
                InputField { x: 176px; y: 72px; width: 84px; text <=> root.dpi-min-text; accepted(value) => { root.apply-dpi-range(value, root.dpi-max-text); } }
                Text { x: 272px; y: 56px; text: "maximum"; color: Theme.muted; font-size: 9px; }
                InputField { x: 272px; y: 72px; width: 84px; text <=> root.dpi-max-text; accepted(value) => { root.apply-dpi-range(root.dpi-min-text, value); } }
                ActionButton { x: 368px; y: 72px; width: 106px; label: "apply range"; primary: true; compact: true; clicked => { root.apply-dpi-range(root.dpi-min-text, root.dpi-max-text); } }
                Text { x: 490px; y: 72px; width: parent.width - 508px; height: 34px; text: "Current: \{round(root.dpi-min)}–\{round(root.dpi-max)} DPI"; color: Theme.muted; font-size: 9px; vertical-alignment: center; overflow: elide; }
            }
            Card {
                width: parent.width; height: root.product-name-choice == 2 ? 178px : 120px;
                Text { x: 18px; y: 16px; text: "display name"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 42px; text: "This name appears at the top of the app."; color: Theme.muted; font-size: 10px; }
                HorizontalLayout { x: 18px; y: 74px; width: parent.width - 36px; height: 34px; spacing: Theme.space-1;
                    ChoiceButton { label: "Attack Shark X3"; compact: true; selected: root.product-name-choice == 0; clicked => { root.select-product-name(0); } }
                    ChoiceButton { label: "Kysona M600"; compact: true; selected: root.product-name-choice == 1; clicked => { root.select-product-name(1); } }
                    ChoiceButton { label: "custom"; compact: true; selected: root.product-name-choice == 2; clicked => { root.select-product-name(2); } }
                }
                if root.product-name-choice == 2 : InputField {
                    x: 18px; y: 126px; width: 360px; text <=> root.custom-product-name;
                    placeholder-text: "enter a display name";
                    accepted(value) => { root.custom-name-changed(value); }
                }
            }
            Card {
                width: parent.width; height: 112px;
                Text { x: 18px; y: 16px; text: "appearance"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { x: 18px; y: 42px; text: "Follow system tracks operating system changes automatically."; color: Theme.muted; font-size: 10px; }
                HorizontalLayout { x: 18px; y: 70px; width: 360px; height: 34px; spacing: Theme.space-1;
                    ChoiceButton { label: "follow system"; compact: true; selected: Theme.appearance == ColorScheme.unknown; clicked => { root.select-appearance(0); } }
                    ChoiceButton { label: "light"; compact: true; selected: Theme.appearance == ColorScheme.light; clicked => { root.select-appearance(1); } }
                    ChoiceButton { label: "dark"; compact: true; selected: Theme.appearance == ColorScheme.dark; clicked => { root.select-appearance(2); } }
                }
            }
        }
    }
}

component StateConflictPopup inherits PopupWindow {
    in property <string> message;
    callback discard;
    callback close-app;
    width: 460px;
    height: 220px;

    Rectangle {
        background: Theme.surface;
        border-color: Theme.warning;
        border-width: 2px;
        border-radius: Theme.radius;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        Text { x: 20px; y: 16px; width: parent.width - 40px; text: "local settings need attention"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Text { x: 20px; y: 50px; width: parent.width - 40px; height: 90px; text: root.message; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        ActionButton { x: 20px; y: parent.height - 54px; width: 178px; label: "reset local data"; primary: true; clicked => { root.discard(); } }
        ActionButton { x: parent.width - 110px; y: parent.height - 54px; width: 90px; label: "quit"; compact: true; clicked => { root.close-app(); } }
        Text { x: 214px; y: parent.height - 46px; width: parent.width - 334px; height: 30px; text: "A backup is kept automatically."; color: Theme.muted; font-size: 9px; wrap: word-wrap; }
    }
}

component TailHideConfirmationPopup inherits PopupWindow {
    in property <int> profile-index: -1;
    callback confirm;
    callback cancel;
    width: 480px;
    height: 230px;

    Rectangle {
        background: Theme.surface;
        border-color: Theme.danger;
        border-width: 2px;
        border-radius: Theme.radius;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        Text { x: 20px; y: 16px; width: parent.width - 40px; text: "hide this profile?"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Text { x: 20px; y: 52px; width: parent.width - 40px; height: 92px; text: "Profile \{root.profile-index + 1} is the last profile that can be hidden. Another profile may become active."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        ActionButton { x: 20px; y: parent.height - 56px; width: 176px; label: "hide profile"; destructive: true; clicked => { root.confirm(); } }
        ActionButton { x: parent.width - 116px; y: parent.height - 56px; width: 96px; label: "cancel"; compact: true; clicked => { root.cancel(); } }
    }
}

component SaveConfirmationPopup inherits PopupWindow {
    in property <string> button-change-summary;
    callback confirm;
    callback cancel;
    width: 560px;
    height: 300px;

    Rectangle {
        background: Theme.surface;
        border-color: Theme.warning;
        border-width: 2px;
        border-radius: Theme.radius;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        Text { x: 20px; y: 16px; width: parent.width - 40px; text: "save these changes to the mouse?"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Rectangle {
            x: 20px; y: 50px; width: parent.width - 40px; height: 112px;
            background: Theme.accent-soft;
            border-color: Theme.accent;
            border-width: 1px;
            border-radius: Theme.radius;
            Text { x: 12px; y: 8px; width: parent.width - 24px; text: "PHYSICAL BUTTON CHANGES"; color: Theme.accent; font-size: 9px; font-weight: 700; }
            Text { x: 12px; y: 28px; width: parent.width - 24px; height: parent.height - 36px; text: root.button-change-summary; color: Theme.text; font-size: 12px; font-weight: 650; wrap: word-wrap; }
        }
        Text { x: 20px; y: 174px; width: parent.width - 40px; height: 58px; text: "Save applies every changed setting. Changed physical button assignments can disable or repurpose mouse buttons."; color: Theme.warning; font-size: 11px; wrap: word-wrap; }
        ActionButton { x: 20px; y: parent.height - 56px; width: 158px; label: "confirm save"; primary: true; clicked => { root.confirm(); } }
        ActionButton { x: parent.width - 116px; y: parent.height - 56px; width: 96px; label: "cancel"; compact: true; clicked => { root.cancel(); } }
    }
}

component CeremonyPopup inherits PopupWindow {
    in property <string> title: "";
    in property <string> instruction: "";
    in property <string> detail: "";
    in property <string> error: "";
    in property <int> prompt: 0;
    in property <string> prompt-label: "";
    in property <bool> can-cancel: false;
    in property <bool> busy: false;
    in property <bool> migration: false;
    in-out property <bool> migration-accept: true;
    callback primary;
    callback cancel;
    callback migration-changed(bool);
    width: 580px;
    height: root.migration ? 372px : 312px;

    Rectangle {
        background: Theme.surface;
        border-color: Theme.accent;
        border-width: 1px;
        border-radius: Theme.radius;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        Text { x: 20px; y: 16px; width: parent.width - 40px; text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
        Text { x: 20px; y: 52px; width: parent.width - 40px; height: 64px; text: root.instruction; color: Theme.text; font-size: 12px; font-weight: 600; wrap: word-wrap; }
        if !root.detail.is-empty : Text { x: 20px; y: 118px; width: parent.width - 40px; text: root.detail; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
        if !root.error.is-empty : Text { x: 20px; y: 144px; width: parent.width - 40px; text: root.error; color: Theme.danger; font-size: 10px; wrap: word-wrap; }
        if root.migration : Rectangle {
            x: 20px; y: 168px; width: parent.width - 40px; height: 108px;
            background: Theme.canvas; border-radius: Theme.radius;
            Text { x: 12px; y: 10px; width: parent.width - 24px; text: "saved settings from the old mouse"; color: Theme.text; font-size: 11px; font-weight: 650; }
            Text { x: 12px; y: 30px; width: parent.width - 24px; text: "The app can keep the old mouse's name and settings when they match one of the captured mice exactly."; color: Theme.muted; font-size: 9px; wrap: word-wrap; }
            HorizontalLayout { x: 12px; y: 60px; width: parent.width - 24px; height: 34px; spacing: 6px;
                ChoiceButton { label: "keep when they match"; compact: true; selected: root.migration-accept; enabled: !root.busy; clicked => { root.migration-accept = true; root.migration-changed(true); } }
                ChoiceButton { label: "start fresh"; compact: true; selected: !root.migration-accept; enabled: !root.busy; clicked => { root.migration-accept = false; root.migration-changed(false); } }
            }
        }
        ActionButton {
            x: 20px; y: parent.height - 58px; width: 224px;
            label: root.prompt-label; primary: true;
            enabled: !root.busy && root.prompt != 0;
            clicked => { root.primary(); }
        }
        if root.can-cancel : ActionButton {
            x: parent.width - 136px; y: parent.height - 58px; width: 116px;
            label: "cancel setup"; compact: true; enabled: !root.busy;
            clicked => { root.cancel(); }
        }
    }
}

component CeremonyTargetPicker inherits PopupWindow {
    in property <[DeviceRow]> devices;
    in property <string> title: "";
    in property <string> detail: "";
    callback picked(string);
    callback cancel;
    width: 480px;
    height: 340px;

    Rectangle {
        background: Theme.surface;
        border-color: Theme.accent;
        border-width: 1px;
        border-radius: Theme.radius;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        Text { x: 20px; y: 16px; width: parent.width - 40px; text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
        Text { x: 20px; y: 48px; width: parent.width - 40px; height: 36px; text: root.detail; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
        ScrollView {
            x: 20px; y: 94px; width: parent.width - 40px; height: 176px;
            VerticalLayout {
                width: parent.width;
                spacing: 4px;
                if root.devices.length == 0 : Text { text: "no saved mice yet"; color: Theme.muted; font-size: 10px; }
                for device in root.devices : Rectangle {
                    height: 44px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: picker-area.has-hover ? Theme.accent : Theme.border;
                    background: picker-area.has-hover ? Theme.surface-raised : Theme.surface;
                    Text { x: 12px; y: 5px; width: parent.width - 24px; height: 16px; text: device.name; color: Theme.text; font-size: 11px; font-weight: 650; overflow: elide; }
                    Text { x: 12px; y: 22px; width: parent.width - 24px; height: 14px; text: device.id + (device.connected ? " · connected" : " · disconnected"); color: Theme.muted; font-size: 9px; overflow: elide; }
                    picker-area := TouchArea {
                        accessible-role: button;
                        accessible-label: "choose " + device.name;
                        accessible-action-default => { root.picked(device.id); }
                        mouse-cursor: pointer;
                        clicked => { root.picked(device.id); }
                    }
                }
            }
        }
        ActionButton { x: parent.width - 116px; y: parent.height - 54px; width: 96px; label: "cancel"; compact: true; clicked => { root.cancel(); } }
    }
}

component AllProfilesRefreshPopup inherits PopupWindow {
    callback confirm;
    callback cancel;
    width: 600px;
    height: 344px;

    Rectangle {
        background: Theme.surface;
        border-color: Theme.warning;
        border-width: 2px;
        border-radius: Theme.radius;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        Text { x: 20px; y: 16px; width: parent.width - 40px; text: "read all five profile slots?"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Text {
            x: 20px; y: 54px; width: parent.width - 40px; height: 178px;
            text: "This reads all five profile slots over USB, switching through each profile to capture DPI, preferences, buttons, and polling rate. It restores your current profile and enabled count when done.\n\nYour saved settings are kept; only new readings are stored, and any differences are reported rather than written back. Keep the mouse connected and don't interrupt this.";
            color: Theme.muted; font-size: 11px; wrap: word-wrap;
        }
        ActionButton { x: 20px; y: parent.height - 58px; width: 194px; label: "read all profiles"; primary: true; clicked => { root.confirm(); } }
        ActionButton { x: parent.width - 116px; y: parent.height - 58px; width: 96px; label: "cancel"; compact: true; clicked => { root.cancel(); } }
    }
}

export component AppWindow inherits Window {
    title: "Attack Shark X3";
    preferred-width: 1160px;
    preferred-height: 720px;
    min-width: 1040px;
    min-height: 680px;
    background: Theme.canvas;

    in-out property <string> state-conflict-text: "";
    in-out property <int> current-page: 0;
    in-out property <int> selected-profile: 0;
    in-out property <int> active-dpi: 0;
    in-out property <int> validation-choice: 0;
    in-out property <int> selected-rate-hz: 1000;
    in-out property <bool> dirty: false;
    in-out property <bool> busy: false;
    in-out property <bool> hardware-ready: false;
    in-out property <bool> polling-rate-ready: false;
    in-out property <bool> motion-sync-readback: false;
    in-out property <bool> ripple-control-readback: false;
    in-out property <bool> dpi-log-scale: true;
    in-out property <int> product-name-choice: 0;
    in-out property <string> product-name: "Attack Shark X3";
    in-out property <string> custom-product-name: "custom mouse";
    in-out property <float> dpi-min: 200.0;
    in-out property <float> dpi-max: 3200.0;
    in-out property <string> dpi-min-text: "200";
    in-out property <string> dpi-max-text: "3200";
    in-out property <string> transport-label: "USB not selected";
    in-out property <string> battery-text: "";
    in-out property <string> lifecycle-text: "starting";
    in-out property <string> device-name: "No device selected";
    in-out property <string> device-id-text: "not available";
    in-out property <string> device-product-text: "not available";
    in-out property <string> profile-summary: "no live profile";
    in-out property <string> active-dpi-text: "not available";
    in-out property <string> active-stage-text: "not available";
    in-out property <string> polling-rate-text: "not available";
    in-out property <string> sensor-summary: "not available";
    in-out property <string> metadata-summary: "not available";
    in-out property <bool> all-profiles-observed: false;
    in-out property <bool> all-profiles-refresh-dismissed: false;
    in-out property <string> verification-text: "no confirmation yet";
    in-out property <string> status-text: "discovering a compatible device";
    in-out property <string> button-change-summary: "No physical button assignments changed.";
    in-out property <string> verification-instruction: "Follow the check instructions above.";

    in-out property <bool> preferences-ready: false;
    in-out property <int> debounce-ms: 8;
    in-out property <int> sleep-half-minutes: 2;
    in-out property <int> deep-sleep-minutes: 60;
    in-out property <bool> deep-sleep-known: false;
    in-out property <int> lift-off-choice: 0;
    in-out property <bool> angle-snap: false;
    in-out property <bool> advanced-preferences: false;
    in-out property <string> preference-configuration-raw: "";
    in-out property <string> preference-deep-sleep-raw: "";
    in-out property <string> preference-sleep-timer-raw: "";
    in-out property <string> preference-debounce-raw: "";
    in-out property <int> baseline-choice-wired: 0;
    in-out property <int> baseline-choice-receiver: 1;
    in-out property <bool> allow-explicit-defaults: false;
    in-out property <bool> ble-device: false;
    in-out property <bool> verification-running: false;
    in-out property <int> last-enabled-profile: -1;
    property <int> pending-hide-profile: -1;
    in-out property <int> pending-unassociated-row: -1;

    in property <[DeviceRow]> devices;
    in property <[UnassociatedRow]> unassociated;
    in property <[DpiStage]> dpi-stages;
    in property <[BindingRow]> bindings;
    in property <[string]> binding-actions;
    in property <[ProfileRow]> profiles;

    in-out property <bool> ceremony-active: false;
    in-out property <string> ceremony-title: "";
    in-out property <string> ceremony-instruction: "";
    in-out property <string> ceremony-detail: "";
    in-out property <string> ceremony-error: "";
    in-out property <int> ceremony-prompt: 0;
    in-out property <string> ceremony-prompt-label: "";
    in-out property <bool> ceremony-can-cancel: false;
    in-out property <bool> ceremony-migration: false;
    in-out property <bool> ceremony-migration-accept: true;

    callback navigate(int);
    callback open-config;
    callback select-device(int);
    callback request-refresh-all-profiles;
    callback dismiss-all-profiles-refresh;
    callback confirm-all-profiles-refresh;
    callback show-all-profiles-refresh;
    callback select-profile(int);
    callback add-profile;
    callback rename-profile(int, string);
    callback hide-profile(int);
    callback select-dpi(int);
    callback drag-dpi(int, float);
    callback add-dpi-stage;
    callback remove-dpi-stage(int);
    callback toggle-dpi-scale;
    callback select-product-name(int);
    callback custom-name-changed(string);
    callback dpi-range-changed(string, string);
    callback set-binding-action(int, string);
    callback select-appearance(int);
    callback request-save;
    callback request-reset;
    callback request-refresh;
    callback set-validation-choice(int);
    callback rate-changed(int);
    callback set-lift-off(int);
    callback toggle-ripple-control(bool);
    callback toggle-angle-snap(bool);
    callback toggle-motion-sync(bool);
    callback set-debounce-ms(int);
    callback set-sleep-half-minutes(int);
    callback set-deep-sleep-minutes(int);
    callback set-debounce-text(string);
    callback set-sleep-text(string);
    callback set-deep-sleep-text(string);
    callback toggle-advanced-preferences;
    callback set-preference-raw(int, string);
    callback set-baseline-choice-wired(int);
    callback set-baseline-choice-receiver(int);
    callback set-allow-explicit-defaults(bool);
    callback request-import;
    callback request-export;
    callback request-invalidate-state;
    callback request-verify-profile;
    callback request-verify-power-cycle;
    callback request-add-mouse;
    callback unassociated-action(int, int);
    callback begin-restore(string);
    callback begin-associate(string);
    callback ceremony-primary;
    callback ceremony-cancel;
    callback ceremony-migration-changed(bool);
    callback close-ceremony;
    callback show-ceremony;
    callback show-restore-picker;
    callback show-associate-picker;
    callback discard-state-schema;
    callback show-state-conflict;
    callback close-state-conflict;
    callback close-app;

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 62px; background: Theme.surface;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
        HorizontalLayout {
            x: 18px; y: 11px; height: 40px; spacing: Theme.space-3; alignment: start;
            VerticalLayout { spacing: 0px; max-width: 240px;
                Text { text: root.product-name; color: Theme.text; font-size: 17px; font-weight: 700; overflow: elide; }
                Text { text: root.device-name; color: Theme.muted; font-size: 10px; overflow: elide; }
            }
            StatusPill { label: root.transport-label + (root.battery-text.is-empty ? "" : " · " + root.battery-text); dot-color: root.hardware-ready ? Theme.success : Theme.warning; compact: true; }
        }
        ActionButton { x: parent.width - 282px; y: 14px; width: 86px; label: "refresh"; compact: true; enabled: !root.busy && !root.dirty; clicked => { root.request-refresh(); } }
        ActionButton { x: parent.width - 188px; y: 14px; width: 126px; label: "discard / reload"; compact: true; enabled: root.hardware-ready && !root.busy; clicked => { root.request-reset(); } }
        Rectangle { x: parent.width - 54px; y: 14px; width: 36px; height: 34px; border-radius: Theme.radius; background: settings-area.has-hover || root.current-page == 5 ? Theme.accent-soft : transparent;
            Image { x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2; width: 18px; height: 18px; source: @image-url("../assets/settings.svg"); image-fit: contain; }
            settings-area := TouchArea { accessible-role: button; accessible-label: "app settings"; accessible-action-default => { root.open-config(); } mouse-cursor: pointer; clicked => { root.open-config(); } }
        }
    }

    Rectangle {
        x: 0px; y: 62px; width: 220px; height: parent.height - 62px; background: Theme.sidebar;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }
        VerticalLayout {
            x: 12px; y: 10px; width: parent.width - 24px; height: 160px; spacing: 0px;
            NavItem { label: "overview"; icon: @image-url("../assets/home.svg"); selected: root.current-page == 0; clicked => { root.navigate(0); } }
            NavItem { label: "buttons"; icon: @image-url("../assets/cursor.svg"); selected: root.current-page == 1; clicked => { root.navigate(1); } }
            NavItem { label: "sensitivity"; icon: @image-url("../assets/target.svg"); selected: root.current-page == 2; clicked => { root.navigate(2); } }
            NavItem { label: "performance"; icon: @image-url("../assets/pulse.svg"); selected: root.current-page == 3; clicked => { root.navigate(3); } }
            NavItem { label: "advanced"; icon: @image-url("../assets/wrench.svg"); selected: root.current-page == 4; clicked => { root.navigate(4); } }
        }
        DeviceSelectorPanel {
            x: 12px; y: 182px; width: parent.width - 24px; height: 112px;
            devices: root.devices; device-count: root.devices.length; interactive: !root.busy;
            select-device(index) => { root.select-device(index); }
        }
        ProfilePanel {
            x: 12px; y: 304px; width: parent.width - 24px; height: parent.height - 318px;
            profiles: root.profiles; last-enabled-index: root.last-enabled-profile; interactive: root.hardware-ready && !root.busy;
            select-profile(index) => { root.select-profile(index); }
            add-profile => { root.add-profile(); }
            rename-profile(index, name) => { root.rename-profile(index, name); }
            hide-profile(index) => { root.pending-hide-profile = index; tail-hide-confirmation.show(); }
        }
    }

    Rectangle {
        x: 220px; y: 62px; width: parent.width - 220px; height: parent.height - 106px; background: Theme.canvas;
        OverviewPage { visible: root.current-page == 0;
            width: parent.width; height: parent.height;
            profile-summary: root.profile-summary; active-dpi-text: root.active-dpi-text; active-stage-text: root.active-stage-text;
            polling-rate-text: root.polling-rate-text; verification-text: root.verification-text; hardware-ready: root.hardware-ready;
            all-profiles-observed: root.all-profiles-observed; all-profiles-refresh-dismissed: root.all-profiles-refresh-dismissed; ble-device: root.ble-device;
            request-refresh-all-profiles => { root.request-refresh-all-profiles(); }
            dismiss-all-profiles-refresh => { root.dismiss-all-profiles-refresh(); }
            navigate(page) => { root.navigate(page); }
        }
        ButtonsPage { visible: root.current-page == 1;
            width: parent.width; height: parent.height; bindings: root.bindings; binding-actions: root.binding-actions; interactive: root.hardware-ready && !root.busy;
            set-binding-action(index, action) => { root.set-binding-action(index, action); }
        }
        SensitivityPage { visible: root.current-page == 2;
            width: parent.width; height: parent.height; dpi-stages: root.dpi-stages; dpi-min: root.dpi-min; dpi-max: root.dpi-max;
            interactive: root.hardware-ready && !root.busy && (root.preferences-ready || (root.ble-device && root.allow-explicit-defaults));
            motion-sync-readback <=> root.motion-sync-readback; ripple-control-readback <=> root.ripple-control-readback;
            angle-snap <=> root.angle-snap; lift-off-choice <=> root.lift-off-choice;
            select-dpi(index) => { root.select-dpi(index); }
            drag-dpi(index, ratio) => { root.drag-dpi(index, ratio); }
            add-dpi-stage => { root.add-dpi-stage(); }
            remove-dpi-stage(index) => { root.remove-dpi-stage(index); }
            open-settings => { root.navigate(5); }
            toggle-motion-sync(value) => { root.toggle-motion-sync(value); }
            toggle-ripple-control(value) => { root.toggle-ripple-control(value); }
            toggle-angle-snap(value) => { root.toggle-angle-snap(value); }
            set-lift-off(value) => { root.set-lift-off(value); }
        }
        PerformancePage { visible: root.current-page == 3;
            width: parent.width; height: parent.height; selected-rate-hz <=> root.selected-rate-hz;
            interactive: root.hardware-ready && !root.busy && (root.preferences-ready || (root.ble-device && root.allow-explicit-defaults));
            rate-interactive: root.hardware-ready && !root.busy && root.polling-rate-ready && !root.ble-device;
            baseline-ready: root.polling-rate-ready; ble-device: root.ble-device; debounce-ms <=> root.debounce-ms; sleep-half-minutes <=> root.sleep-half-minutes; deep-sleep-minutes <=> root.deep-sleep-minutes; deep-sleep-known: root.deep-sleep-known;
            rate-changed(value) => { root.rate-changed(value); }
            set-debounce-ms(value) => { root.set-debounce-ms(value); }
            set-sleep-half-minutes(value) => { root.set-sleep-half-minutes(value); }
            set-deep-sleep-minutes(value) => { root.set-deep-sleep-minutes(value); }
            set-debounce-text(value) => { root.set-debounce-text(value); }
            set-sleep-text(value) => { root.set-sleep-text(value); }
            set-deep-sleep-text(value) => { root.set-deep-sleep-text(value); }
        }
        AdvancedPage { visible: root.current-page == 4;
            width: parent.width; height: parent.height; devices: root.devices; transport-label: root.transport-label; device-name: root.device-name; device-id-text: root.device-id-text; device-product-text: root.device-product-text; metadata-summary: root.metadata-summary; lifecycle-text: root.lifecycle-text;
            validation-choice: root.validation-choice; interactive: root.hardware-ready && !root.busy; preferences-ready: root.preferences-ready; ble-device: root.ble-device; all-profiles-observed: root.all-profiles-observed;
            baseline-choice-wired <=> root.baseline-choice-wired; baseline-choice-receiver <=> root.baseline-choice-receiver; allow-explicit-defaults <=> root.allow-explicit-defaults; advanced-preferences <=> root.advanced-preferences;
            preference-configuration-raw <=> root.preference-configuration-raw; preference-deep-sleep-raw <=> root.preference-deep-sleep-raw; preference-sleep-timer-raw <=> root.preference-sleep-timer-raw; preference-debounce-raw <=> root.preference-debounce-raw;
            verification-running: root.verification-running; verification-instruction: root.verification-instruction;
            unassociated: root.unassociated; ceremony-active: root.ceremony-active;
            set-validation-choice(value) => { root.set-validation-choice(value); }
            set-baseline-choice-wired(value) => { root.set-baseline-choice-wired(value); }
            set-baseline-choice-receiver(value) => { root.set-baseline-choice-receiver(value); }
            set-allow-explicit-defaults(value) => { root.set-allow-explicit-defaults(value); }
            toggle-advanced-preferences => { root.toggle-advanced-preferences(); }
            set-preference-raw(index, value) => { root.set-preference-raw(index, value); }
            request-import => { root.request-import(); }
            request-export => { root.request-export(); }
            request-invalidate-state => { root.request-invalidate-state(); }
            request-refresh-all-profiles => { root.request-refresh-all-profiles(); }
            request-verify-profile => { root.request-verify-profile(); }
            request-verify-power-cycle => { root.request-verify-power-cycle(); }
            request-add-mouse => { root.request-add-mouse(); }
            unassociated-action(row, action) => { root.unassociated-action(row, action); }
            show-ceremony => { root.show-ceremony(); }
        }
        SettingsPage { visible: root.current-page == 5;
            width: parent.width; height: parent.height; product-name-choice: root.product-name-choice; custom-product-name <=> root.custom-product-name;
            logarithmic-scale: root.dpi-log-scale; dpi-min: root.dpi-min; dpi-max: root.dpi-max;
            dpi-min-text <=> root.dpi-min-text; dpi-max-text <=> root.dpi-max-text;
            select-product-name(index) => { root.select-product-name(index); }
            custom-name-changed(name) => { root.custom-name-changed(name); }
            select-appearance(value) => { root.select-appearance(value); }
            toggle-dpi-scale => { root.toggle-dpi-scale(); }
            apply-dpi-range(minimum, maximum) => { root.dpi-range-changed(minimum, maximum); }
        }
    }

    Rectangle {
        x: 220px; y: parent.height - 44px; width: parent.width - 220px; height: 44px; background: Theme.surface;
        Rectangle { width: parent.width; height: 1px; background: Theme.border; }
        Rectangle { x: 16px; y: 18px; width: 7px; height: 7px; border-radius: 4px; background: root.busy ? Theme.warning : root.hardware-ready ? (root.dirty ? Theme.warning : Theme.success) : Theme.warning; }
        Text { x: 32px; width: parent.width - 270px; height: parent.height; text: root.status-text; color: root.busy ? Theme.warning : Theme.muted; font-size: 9px; vertical-alignment: center; overflow: elide; }
        Text { x: parent.width - 258px; width: 86px; height: parent.height; text: root.busy ? "busy" : root.hardware-ready ? (root.dirty ? "unsaved" : "saved") : "not connected"; color: root.busy || root.dirty || !root.hardware-ready ? Theme.warning : Theme.success; font-size: 9px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
        ActionButton { x: parent.width - 158px; y: 5px; width: 142px; height: 34px; label: root.dirty ? "save changes" : "no changes"; primary: root.dirty; compact: true; enabled: root.hardware-ready && !root.busy && root.dirty; clicked => { save-confirmation.show(); } }
    }

    state-conflict := StateConflictPopup {
        x: 300px; y: 210px; close-policy: no-auto-close; message: root.state-conflict-text;
        discard => { root.discard-state-schema(); }
        close-app => { root.close-app(); }
    }
    ceremony := CeremonyPopup {
        x: 280px; y: 160px; close-policy: no-auto-close;
        title: root.ceremony-title; instruction: root.ceremony-instruction; detail: root.ceremony-detail; error: root.ceremony-error;
        prompt: root.ceremony-prompt; prompt-label: root.ceremony-prompt-label; can-cancel: root.ceremony-can-cancel;
        busy: root.busy; migration: root.ceremony-migration; migration-accept <=> root.ceremony-migration-accept;
        primary => { root.ceremony-primary(); }
        cancel => { root.ceremony-cancel(); }
        migration-changed(value) => { root.ceremony-migration-changed(value); }
    }
    restore-picker := CeremonyTargetPicker {
        x: 330px; y: 190px; close-policy: no-auto-close;
        devices: root.devices;
        title: "restore a saved mouse";
        detail: "Choose which saved mouse this unrecognized mouse should become. You'll reconnect the physical mouse to confirm.";
        picked(id) => { restore-picker.close(); root.begin-restore(id); }
        cancel => { restore-picker.close(); }
    }
    associate-picker := CeremonyTargetPicker {
        x: 330px; y: 190px; close-policy: no-auto-close;
        devices: root.devices;
        title: "pair with a saved mouse";
        detail: "Choose which saved mouse this bluetooth mouse should pair with.";
        picked(id) => { associate-picker.close(); root.begin-associate(id); }
        cancel => { associate-picker.close(); }
    }
    tail-hide-confirmation := TailHideConfirmationPopup {
        x: 300px; y: 210px; close-policy: no-auto-close; profile-index: root.pending-hide-profile;
        confirm => { tail-hide-confirmation.close(); root.hide-profile(root.pending-hide-profile); root.pending-hide-profile = -1; }
        cancel => { tail-hide-confirmation.close(); root.pending-hide-profile = -1; }
    }
    save-confirmation := SaveConfirmationPopup {
        x: 300px; y: 190px; close-policy: no-auto-close; button-change-summary: root.button-change-summary;
        confirm => { save-confirmation.close(); root.request-save(); }
        cancel => { save-confirmation.close(); }
    }
    all-profiles-refresh-confirmation := AllProfilesRefreshPopup {
        x: 280px; y: 188px; close-policy: no-auto-close;
        confirm => { all-profiles-refresh-confirmation.close(); root.confirm-all-profiles-refresh(); }
        cancel => { all-profiles-refresh-confirmation.close(); }
    }
    show-all-profiles-refresh => { all-profiles-refresh-confirmation.show(); }
    show-state-conflict => { state-conflict.show(); }
    show-ceremony => { ceremony.show(); }
    close-ceremony => { ceremony.close(); root.ceremony-active = false; }
    show-restore-picker => { restore-picker.show(); }
    show-associate-picker => { associate-picker.show(); }
    close-state-conflict => { state-conflict.close(); }
}
