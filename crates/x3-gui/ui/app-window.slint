import { AboutSlint, ScrollView } from "std-widgets.slint";

export global Theme {
    in-out property <bool> dark-mode: false;
    out property <color> canvas: dark-mode ? #101116 : #f5f6fa;
    out property <color> surface: dark-mode ? #191b22 : #ffffff;
    out property <color> surface-raised: dark-mode ? #21232c : #fbfbfd;
    out property <color> sidebar: dark-mode ? #14151b : #fcfcfe;
    out property <color> text: dark-mode ? #f4f4f7 : #18191f;
    out property <color> muted: dark-mode ? #9699a8 : #747783;
    out property <color> faint: dark-mode ? #2a2c35 : #e8e9ef;
    out property <color> border: dark-mode ? #30323d : #e1e3e9;
    out property <color> accent: dark-mode ? #d0d1d5 : #66686e;
    out property <color> accent-soft: dark-mode ? #2b2d31 : #eceef1;
    out property <color> teal: dark-mode ? #b5b8be : #72757b;
    out property <color> success: dark-mode ? #b7babf : #686b70;
    out property <color> warning: #a27642;
    out property <length> radius: 4px;
    out property <length> compact-gap: 6px;
    out property <length> control-height: 34px;
}

export struct DpiStage {
    index: string,
    value: string,
    dpi: float,
    ratio: float,
    label: string,
    accent: color,
    active: bool,
}

export struct BindingRow {
    button: string,
    location: string,
    action: string,
}

export struct ProfileRow {
    name: string,
    subtitle: string,
    active: bool,
    visible: bool,
    enabled: bool,
}
component Card inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    callback clicked;
    height: compact ? Theme.control-height : 38px;
    min-width: compact ? 86px : 108px;
    border-radius: Theme.radius;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    background: primary ? Theme.accent : area.has-hover ? Theme.surface-raised : Theme.surface;
    opacity: root.enabled ? 1.0 : 0.45;

    Text {
        text: root.label;
        color: root.primary ? #ffffff : Theme.text;
        font-size: root.compact ? 13px : 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component StatusPill inherits Rectangle {
    in property <string> label;
    in property <color> dot-color: Theme.success;
    height: 30px;
    width: 160px;
    border-radius: Theme.radius;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: Theme.border;

    Rectangle { x: 12px; y: 12px; width: 8px; height: 8px; border-radius: 4px; background: root.dot-color; }
    Text {
        x: 28px; width: parent.width - 38px; height: parent.height;
        text: root.label;
        color: Theme.text;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    in property <image> icon;
    in property <bool> selected;
    callback clicked;
    height: 42px;
    border-radius: Theme.radius;
    background: selected ? Theme.accent-soft : area.has-hover ? Theme.surface-raised : transparent;

    Rectangle { x: 0; width: 3px; height: parent.height; background: root.selected ? Theme.accent : transparent; }
    Image { x: 13px; y: 11px; width: 20px; height: 20px; source: root.icon; image-fit: contain; }
    Text {
        x: 44px; width: parent.width - 54px; height: parent.height;
        text: root.label;
        color: root.selected ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
    }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component MetricCard inherits Card {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <color> accent: Theme.accent;
    height: 112px;

    Rectangle { x: 18px; y: 18px; width: 8px; height: 8px; border-radius: 4px; background: root.accent; }
    Text { x: 34px; y: 13px; text: root.label; color: Theme.muted; font-size: 12px; }
    Text { x: 18px; y: 42px; text: root.value; color: Theme.text; font-size: 27px; font-weight: 700; }
    Text { x: 18px; y: 80px; text: root.detail; color: Theme.muted; font-size: 11px; }
}

component SectionTitle inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: 52px;
    background: transparent;
    Text { x: 0; y: 0; text: root.title; color: Theme.text; font-size: 21px; font-weight: 700; }
    Text { x: 0; y: 31px; text: root.subtitle; color: Theme.muted; font-size: 12px; }
}

component MouseArtwork inherits Rectangle {
    background: transparent;
    Image {
        width: parent.width; height: parent.height;
        source: @image-url("../assets/mouse-top.png");
        image-fit: contain;
        cache-rendering-hint: true;
    }
}
component InputField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <length> font-size: 12px;
    callback accepted(string);
    height: 34px;
    border-radius: Theme.radius;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.surface-raised;

    if input.text.is-empty : Text {
        x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
        text: root.placeholder-text; color: Theme.muted; font-size: root.font-size;
        vertical-alignment: center; overflow: elide;
    }
    input := TextInput {
        x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
        text <=> root.text; color: Theme.text; font-size: root.font-size;
        selection-foreground-color: Theme.text; selection-background-color: Theme.accent-soft;
        vertical-alignment: center; single-line: true;
        accepted => { root.accepted(self.text); }
    }
}
component ProfileListItem inherits Rectangle {
    in property <ProfileRow> profile;
    in property <int> item-index;
    in property <bool> interactive: true;
    callback selected(int);
    height: profile.visible ? 42px : 0px;
    visible: profile.visible;
    opacity: profile.enabled && root.interactive ? 1.0 : 0.45;
    border-radius: Theme.radius;
    border-width: profile.active ? 2px : 1px;
    border-color: profile.active ? Theme.accent : Theme.border;
    background: profile.active ? Theme.accent-soft : root.interactive && row-area.has-hover ? Theme.surface-raised : Theme.surface;

    row-area := TouchArea {
        enabled: root.profile.enabled && root.interactive;
        accessible-role: button;
        accessible-label: root.profile.name;
        accessible-action-default => { if (root.interactive) { root.selected(root.item-index); } }
        mouse-cursor: root.profile.enabled && root.interactive ? pointer : default;
        clicked => { root.selected(root.item-index); }
    }
    Text {
        x: 10px; width: parent.width - 18px; height: 24px;
        text: root.profile.name; color: Theme.text; font-size: 12px;
        font-weight: root.profile.active ? 650 : 500; vertical-alignment: center; overflow: elide;
    }
    Text {
        x: 10px; y: 24px; width: parent.width - 18px; height: 14px;
        text: root.profile.subtitle; color: Theme.muted; font-size: 9px; overflow: elide;
    }
}
component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in-out property <bool> checked;
    in property <bool> interactive: true;
    callback toggled(bool);
    height: 70px;
    background: transparent;
    border-color: Theme.border;
    border-width: 0px;
    opacity: root.interactive ? 1.0 : 0.55;

    Text { x: 0; y: 13px; text: root.label; color: Theme.text; font-size: 14px; font-weight: 600; }
    Text { x: 0; y: 37px; text: root.detail; color: Theme.muted; font-size: 11px; }
    Rectangle {
        x: parent.width - 48px; y: 22px; width: 46px; height: 26px; border-radius: 13px;
        background: root.checked ? Theme.accent : Theme.faint;
        Rectangle {
            x: root.checked ? 23px : 3px; y: 3px; width: 20px; height: 20px; border-radius: 10px; background: #ffffff;
            animate x { duration: 120ms; }
        }
        TouchArea {
            enabled: root.interactive;
            accessible-role: button;
            accessible-label: root.label + (root.checked ? " on" : " off");
            accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
            mouse-cursor: pointer;
            clicked => { root.checked = !root.checked; root.toggled(root.checked); }
        }
    }
}

component OverviewPage inherits Rectangle {
    in property <[ProfileRow]> profiles;
    in property <string> transport-label;
    in property <string> battery-text;
    in property <string> device-name;
    in property <string> profile-summary;
    in property <string> active-dpi-text;
    in property <string> active-stage-text;
    in property <string> polling-rate-text;
    in property <string> verification-text;
    in property <bool> hardware-ready: false;
    callback select-profile(int);
    background: transparent;

    SectionTitle { x: 24px; y: 20px; title: "overview"; subtitle: "live values read from the selected USB device."; }

    Card {
        x: 24px; y: 88px; width: parent.width - 48px; height: 236px;
        background: Theme.surface;
        Text { x: 24px; y: 24px; text: root.device-name; color: Theme.text; font-size: 12px; font-weight: 700; }
        Text { x: 24px; y: 56px; text: "hardware state\nfrom manager readback."; color: Theme.text; font-size: 30px; font-weight: 700; }
        Text { x: 24px; y: 140px; width: 360px; text: root.profile-summary; color: Theme.muted; font-size: 13px; }
        StatusPill { x: 24px; y: 178px; label: root.transport-label; dot-color: root.hardware-ready ? Theme.success : Theme.warning; }
        MouseArtwork { x: parent.width - 306px; y: 14px; width: 220px; height: 208px; }
    }

    HorizontalLayout {
        x: 24px; y: 340px; width: parent.width - 48px; height: 104px; spacing: Theme.compact-gap;
        MetricCard { label: "active dpi"; value: root.active-dpi-text; detail: root.active-stage-text; accent: Theme.accent; }
        MetricCard { label: "polling rate"; value: root.polling-rate-text; detail: "live USB readback"; accent: Theme.muted; }
        MetricCard { label: "battery"; value: root.battery-text; detail: root.battery-text; accent: Theme.success; }
        MetricCard { label: "verification"; value: root.hardware-ready ? "readback" : "unavailable"; detail: root.verification-text; accent: root.hardware-ready ? Theme.muted : Theme.warning; }
    }

    Card {
        x: 24px; y: 462px; width: parent.width - 48px; height: 74px;
        Text { x: 16px; y: 13px; text: "fixed device profile slots"; color: Theme.text; font-size: 13px; font-weight: 650; }
        Text { x: 16px; y: 38px; text: "only enabled slots can be activated; names and slot count are hardware metadata."; color: Theme.muted; font-size: 11px; }
    }
}

component BindingCard inherits Rectangle {
    in property <BindingRow> item;
    in property <int> item-index;
    in property <bool> interactive: true;
    callback clicked(int);
    height: 64px;
    border-radius: Theme.radius;
    border-width: 1px;
    accessible-role: button;
    accessible-label: "binding " + item.button;
    accessible-action-default => { if (root.interactive) { root.clicked(root.item-index); } }
    border-color: Theme.border;
    background: root.interactive && area.has-hover ? Theme.accent-soft : Theme.surface-raised;
    opacity: root.interactive ? 1.0 : 0.55;

    Text { x: 14px; y: 12px; text: item.button; color: Theme.text; font-size: 13px; font-weight: 700; }
    Text { x: 14px; y: 34px; text: item.location; color: Theme.muted; font-size: 10px; }
    Text { x: 112px; y: 0px; width: parent.width - 144px; height: parent.height; text: item.action; color: Theme.text; font-size: 12px; vertical-alignment: center; }
    Text { x: parent.width - 24px; y: 0px; width: 12px; height: parent.height; text: ">"; color: Theme.muted; font-size: 15px; vertical-alignment: center; }
    area := TouchArea { enabled: root.interactive; mouse-cursor: root.interactive ? pointer : default; clicked => { root.clicked(root.item-index); } }
}

component ButtonsPage inherits Rectangle {
    in property <[BindingRow]> bindings;
    in property <bool> interactive: false;
    callback cycle-binding(int);
    background: transparent;

    Card {
        x: 12px; y: 12px; width: parent.width - 378px; height: parent.height - 24px;
        clip: true;
        cache-rendering-hint: true;
        Text {
            x: 18px; y: 16px; width: parent.width - 36px;
            text: "the table at right is the live manager readback";
            color: Theme.muted; font-size: 10px;
        }
        MouseArtwork {
            x: parent.width / 2 - 150px; y: 44px;
            width: 300px; height: parent.height - 72px;
        }
    }

    Card {
        x: parent.width - 354px; y: 12px; width: 342px; height: parent.height - 24px;
        Text { x: 16px; y: 14px; text: "button bindings"; color: Theme.text; font-size: 15px; font-weight: 700; }
        Text {
            x: 16px; y: 37px;
            text: root.interactive ? "select a row to draft a safe action" : "controls locked while hardware is unavailable or busy";
            color: Theme.muted; font-size: 10px;
        }
        VerticalLayout {
            x: 12px; y: 64px; width: parent.width - 24px; height: 420px; spacing: 6px;
            for item[index] in root.bindings : BindingCard {
                item: item;
                interactive: root.interactive;
                item-index: index;
                clicked(item-index) => { root.cycle-binding(item-index); }
            }
        }
    }
}

component DpiStageRow inherits Rectangle {
    in property <DpiStage> stage;
    in property <int> item-index;
    in property <bool> logarithmic-scale;
    in property <float> dpi-min;
    in property <float> dpi-max;
    in property <bool> interactive: false;
    callback clicked(int);
    callback dragged(int, float);
    callback remove(int);
    height: 43px;
    border-radius: Theme.radius;
    border-width: stage.active ? 2px : 1px;
    border-color: stage.active ? stage.accent : Theme.border;
    background: stage.active ? Theme.accent-soft : root.interactive && row-area.has-hover ? Theme.surface-raised : Theme.surface;

    property <float> pointer-ratio: max(0.0, min(1.0, (track-area.mouse-x - 6px) / (track-area.width - 12px)));

    Rectangle { x: 14px; y: 8px; width: 6px; height: 27px; border-radius: 3px; background: stage.accent; }
    Text { x: 34px; y: 8px; width: 22px; text: stage.index; color: Theme.muted; font-size: 10px; font-weight: 700; }
    Text { x: 62px; y: 5px; width: 104px; text: stage.value + " dpi"; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
    Text { x: 62px; y: 26px; width: 104px; text: stage.label; color: Theme.muted; font-size: 10px; overflow: elide; }

    Rectangle { x: 180px; y: 21px; width: parent.width - 244px; height: 2px; background: Theme.border; }
    Rectangle { x: 180px + (parent.width - 244px) * stage.ratio - 5px; y: 17px; width: 10px; height: 10px; border-radius: 5px; background: stage.active ? stage.accent : Theme.muted; }

    track-area := TouchArea {
        enabled: root.interactive;
        x: 174px; y: 7px; width: parent.width - 238px; height: 29px;
        accessible-role: button;
        accessible-label: "adjust dpi stage " + root.stage.index;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.dragged(root.item-index, root.pointer-ratio); }
        moved => { if (track-area.pressed) { root.dragged(root.item-index, root.pointer-ratio); } }
    }

    Rectangle {
        x: parent.width - 42px; y: 6px; width: 30px; height: 32px; border-radius: Theme.radius;
        background: Theme.surface-raised; opacity: 0.45;
        Text { width: parent.width; height: parent.height; text: "−"; color: Theme.muted; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: -34px; y: 8px; width: 32px; text: "not available"; color: Theme.muted; font-size: 8px; horizontal-alignment: right; }
    }
    row-area := TouchArea {
        enabled: root.interactive;
        x: 0; y: 0; width: 170px; height: parent.height;
        accessible-role: button;
        accessible-label: "select dpi stage " + root.stage.index;
        accessible-action-default => { if (root.interactive) { root.clicked(root.item-index); } }
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(root.item-index); }
    }
}

component DpiPage inherits Rectangle {
    in property <[DpiStage]> dpi-stages;
    in property <bool> logarithmic-scale;
    in property <float> dpi-min;
    in property <float> dpi-max;
    in property <bool> interactive: false;
    in property <bool> motion-sync-readback: false;
    in property <bool> ripple-control-readback: false;
    callback select-dpi(int);
    callback drag-dpi(int, float);
    callback add-dpi-stage;
    callback remove-dpi-stage(int);
    callback toggle-dpi-scale;
    background: transparent;

    SectionTitle { x: 28px; y: 24px; title: "sensitivity"; subtitle: "edit the live DPI ladder; stage count changes are not implemented."; }

    Card {
        x: 28px; y: 104px; width: parent.width - 414px; height: parent.height - 116px;
        Text { x: 18px; y: 14px; text: "dpi stages"; color: Theme.text; font-size: 15px; font-weight: 700; }
        Text { x: 18px; y: 37px; width: parent.width - 306px; text: "drag a stage to set its value. Add/remove stage is not implemented."; color: Theme.muted; font-size: 10px; overflow: elide; }
        ActionButton {
            x: parent.width - 270px; y: 12px; width: 128px; label: root.logarithmic-scale ? "scale: log (local)" : "scale: linear (local)"; compact: true;
            clicked => { root.toggle-dpi-scale(); }
        }
        ActionButton {
            x: parent.width - 132px; y: 12px; width: 112px; label: "add (not implemented)"; compact: true; enabled: false;
        }
        VerticalLayout {
            x: 14px; y: 68px; width: parent.width - 28px; height: parent.height - 82px; spacing: 3px;
            for stage[index] in root.dpi-stages : DpiStageRow {
                item-index: index;
                stage: stage;
                logarithmic-scale: root.logarithmic-scale;
                dpi-min: root.dpi-min;
                dpi-max: root.dpi-max;
                interactive: root.interactive;
                clicked(item-index) => { root.select-dpi(item-index); }
                dragged(item-index, ratio) => { root.drag-dpi(item-index, ratio); }
                remove(item-index) => { root.remove-dpi-stage(item-index); }
            }
        }
    }

    Card {
        x: parent.width - 372px; y: 104px; width: 344px; height: parent.height - 116px;
        Text { x: 20px; y: 18px; text: "sensor tuning"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Text { x: 20px; y: 47px; text: "readback is shown; sensor editing is not implemented."; color: Theme.muted; font-size: 10px; }
        Rectangle { x: 20px; y: 72px; width: parent.width - 40px; height: 1px; background: Theme.border; }
        ToggleRow { x: 20px; y: 82px; width: parent.width - 40px; label: "motion sync (not implemented)"; detail: "live readback only; this control is disabled"; checked: root.motion-sync-readback; interactive: false; }
        Rectangle { x: 20px; y: 152px; width: parent.width - 40px; height: 1px; background: Theme.border; }
        ToggleRow { x: 20px; y: 166px; width: parent.width - 40px; label: "ripple control (not implemented)"; detail: "live readback only; this control is disabled"; checked: root.ripple-control-readback; interactive: false; }
        Rectangle { x: 20px; y: 236px; width: parent.width - 40px; height: 1px; background: Theme.border; }
        Text { x: 20px; y: 252px; text: "lift-off distance (not implemented)"; color: Theme.text; font-size: 14px; font-weight: 600; }
        Text { x: 20px; y: 276px; text: "sensor preference editing is not available yet."; color: Theme.muted; font-size: 10px; }
        Rectangle {
            x: 20px; y: 304px; width: parent.width - 40px; height: 46px; border-radius: Theme.radius; background: Theme.surface-raised; border-width: 1px; border-color: Theme.border; opacity: 0.5;
            Text { width: parent.width; height: parent.height; text: "not implemented"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle { x: 20px; y: 366px; width: parent.width - 40px; height: 76px; border-radius: Theme.radius; background: Theme.accent-soft;
            Text { x: 14px; y: 12px; text: "safe editing"; color: Theme.text; font-size: 12px; font-weight: 700; }
            Text { x: 14px; y: 35px; width: parent.width - 28px; text: "DPI writes use manager deltas and preserve unknown bytes."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
        }
    }
}

component SettingsPage inherits Rectangle {
    in property <int> product-name-choice;
    in-out property <string> custom-product-name;
    in property <bool> white-mouse;
    in property <bool> logarithmic-scale;
    in-out property <string> dpi-min-text;
    in-out property <string> dpi-max-text;
    callback select-product-name(int);
    callback custom-name-changed(string);
    callback toggle-shell;
    callback toggle-dpi-scale;
    callback dpi-min-changed(string);
    callback dpi-max-changed(string);
    callback back;
    background: transparent;

    SectionTitle { x: 28px; y: 24px; title: "configuration"; subtitle: "appearance, product identity, and dpi behavior."; }
    ActionButton { x: parent.width - 130px; y: 28px; width: 102px; label: "back"; compact: true; clicked => { root.back(); } }

    Card {
        x: 28px; y: 104px; width: parent.width - 56px; height: 190px;
        Text { x: 20px; y: 18px; text: "appearance"; color: Theme.text; font-size: 15px; font-weight: 700; }
        Text { x: 20px; y: 44px; text: "local-only controls; they never mark hardware dirty."; color: Theme.muted; font-size: 10px; }
        Text { x: 20px; y: 78px; text: "mouse shell"; color: Theme.text; font-size: 12px; font-weight: 600; }
        ActionButton {
            x: 20px; y: 101px; width: 132px; label: root.white-mouse ? "white mouse" : "black mouse"; compact: true;
            clicked => { root.toggle-shell(); }
        }
        Text { x: 210px; y: 78px; text: "product name"; color: Theme.text; font-size: 12px; font-weight: 600; }
        ActionButton { x: 210px; y: 101px; width: 142px; label: "attack shark x3"; compact: true; primary: root.product-name-choice == 0; clicked => { root.select-product-name(0); } }
        ActionButton { x: 362px; y: 101px; width: 126px; label: "kysona m600"; compact: true; primary: root.product-name-choice == 1; clicked => { root.select-product-name(1); } }
        ActionButton { x: 498px; y: 101px; width: 92px; label: "custom"; compact: true; primary: root.product-name-choice == 2; clicked => { root.select-product-name(2); } }
        if root.product-name-choice == 2 : InputField {
            x: 210px; y: 145px; width: 300px; height: 32px;
            text: root.custom-product-name; placeholder-text: "enter custom name"; font-size: 12px;
            accepted(text) => { root.custom-name-changed(text); }
        }
        Text { x: 620px; y: 110px; width: parent.width - 640px; text: "white artwork is not installed yet."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
    }

    Card {
        x: 28px; y: 306px; width: parent.width - 56px; height: parent.height - 330px;
        Text { x: 20px; y: 18px; text: "dpi behavior (local-only)"; color: Theme.text; font-size: 15px; font-weight: 700; }
        Text { x: 20px; y: 44px; text: "visual range and scale only; hardware DPI values are edited on Sensitivity."; color: Theme.muted; font-size: 10px; }
        Text { x: 20px; y: 82px; text: "visual scale"; color: Theme.text; font-size: 12px; font-weight: 600; }
        ActionButton {
            x: 20px; y: 104px; width: 128px; label: root.logarithmic-scale ? "scale: log (local)" : "scale: linear (local)"; compact: true;
            clicked => { root.toggle-dpi-scale(); }
        }
        Text { x: 210px; y: 82px; text: "visual minimum dpi"; color: Theme.text; font-size: 12px; font-weight: 600; }
        InputField {
            x: 210px; y: 104px; width: 100px; height: 34px; text <=> root.dpi-min-text; font-size: 12px;
            accepted(text) => { root.dpi-min-changed(text); }
        }
        Text { x: 330px; y: 82px; text: "visual maximum dpi"; color: Theme.text; font-size: 12px; font-weight: 600; }
        InputField {
            x: 330px; y: 104px; width: 100px; height: 34px; text <=> root.dpi-max-text; font-size: 12px;
            accepted(text) => { root.dpi-max-changed(text); }
        }
        Text { x: 20px; y: 166px; width: parent.width - 40px; text: "local-only visual bounds. Hardware values remain exact and are changed only by the Sensitivity ladder."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
    }
}

component RateChoice inherits Rectangle {
    in property <string> value;
    in property <bool> selected;
    in property <bool> interactive: true;
    accessible-role: button;
    accessible-label: root.value + " hz polling rate";
    accessible-action-default => { if (root.interactive) { root.clicked(); } }
    callback clicked;
    height: 74px;
    border-radius: Theme.radius;
    border-width: selected ? 2px : 1px;
    border-color: selected ? (interactive ? Theme.accent : Theme.muted) : (interactive ? Theme.border : Theme.faint);
    background: !interactive ? Theme.canvas : selected ? Theme.accent-soft : Theme.surface;
    opacity: interactive ? 1.0 : 0.55;
    Text { y: 14px; width: parent.width; text: root.value; color: Theme.text; font-size: 19px; font-weight: 700; horizontal-alignment: center; }
    Text { y: 44px; width: parent.width; text: "hz"; color: Theme.muted; font-size: 10px; horizontal-alignment: center; }
    TouchArea { enabled: root.interactive; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component PerformancePage inherits Rectangle {
    in-out property <int> selected-rate-hz: 1000;
    in property <bool> interactive: false;
    in property <bool> baseline-ready: false;
    callback rate-changed(int);
    SectionTitle { x: 28px; y: 24px; title: "performance"; subtitle: "polling rate is a supported USB write; other preferences are not implemented."; }

    Card {
        x: 28px; y: 104px; width: parent.width - 56px; height: 196px;
        Text { x: 20px; y: 18px; text: "polling rate"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Text { x: 20px; y: 45px; text: "choose a USB rate, then Save changes."; color: Theme.muted; font-size: 10px; }
        HorizontalLayout {
            x: 20px; y: 78px; width: parent.width - 40px; height: 74px; spacing: 10px;
            RateChoice { value: "125"; selected: root.selected-rate-hz == 125; interactive: root.interactive; clicked => { root.selected-rate-hz = 125; root.rate-changed(125); } }
            RateChoice { value: "250"; selected: root.selected-rate-hz == 250; interactive: root.interactive; clicked => { root.selected-rate-hz = 250; root.rate-changed(250); } }
            RateChoice { value: "500"; selected: root.selected-rate-hz == 500; interactive: root.interactive; clicked => { root.selected-rate-hz = 500; root.rate-changed(500); } }
            RateChoice { value: "1000"; selected: root.selected-rate-hz == 1000; interactive: root.interactive; clicked => { root.selected-rate-hz = 1000; root.rate-changed(1000); } }
        }
        if !root.interactive : Text {
            x: 20px; y: 164px; width: parent.width - 40px;
            text: root.baseline-ready
                ? "rate selection is disabled while hardware controls are locked"
                : "not available in this GUI yet: reconcile complete desired DPI, preferences, and buttons with x3ctl import first";
            color: Theme.warning; font-size: 10px; wrap: word-wrap;
        }
    }

    Card {
        x: 28px; y: 324px; width: (parent.width - 68px) / 2; height: 290px;
        Text { x: 20px; y: 18px; text: "click latency (not implemented)"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Text { x: 20px; y: 52px; width: parent.width - 40px; text: "debounce editing is not wired to a typed manager delta."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
        ToggleRow { x: 20px; y: 120px; width: parent.width - 40px; label: "competitive preset (not implemented)"; detail: "disabled until semantics are supported"; checked: false; interactive: false; }
    }

    Card {
        x: 40px + (parent.width - 68px) / 2; y: 324px; width: (parent.width - 68px) / 2; height: 290px;
        Text { x: 20px; y: 18px; text: "power management (not implemented)"; color: Theme.text; font-size: 16px; font-weight: 700; }
        ToggleRow { x: 20px; y: 54px; width: parent.width - 40px; label: "deep sleep (not implemented)"; detail: "disabled; no local-only illusion"; checked: false; interactive: false; }
        Text { x: 20px; y: 150px; text: "sleep timer (not implemented)"; color: Theme.text; font-size: 13px; font-weight: 600; }
        Rectangle { x: 20px; y: 181px; width: parent.width - 40px; height: 52px; border-radius: Theme.radius; background: Theme.canvas; border-width: 1px; border-color: Theme.faint; opacity: 0.5;
            Text { width: parent.width; height: parent.height; text: "not available"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}


component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 54px;
    background: transparent;
    Text { x: 0; height: parent.height; text: root.label; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
    Text { x: 160px; width: parent.width - 160px; height: parent.height; text: root.value; color: Theme.text; font-size: 12px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
}

component DevicePage inherits Rectangle {
    in property <string> transport-label;
    in property <string> battery-text;
    in property <string> device-name;
    in property <string> device-id-text;
    in property <string> device-product-text;
    in property <string> metadata-summary;
    in property <string> sensor-summary;
    in property <string> lifecycle-text;
    in property <bool> interactive: false;
    in-out property <int> validation-choice;
    callback set-validation-choice(int);
    background: transparent;
    SectionTitle { x: 28px; y: 24px; title: "device"; subtitle: "identity, USB transport, and configuration evidence."; }

    Card {
        x: 28px; y: 104px; width: 360px; height: 504px;
        Rectangle { x: 66px; y: 30px; width: parent.width - 132px; height: 214px; border-radius: 107px; background: Theme.accent; opacity: 0.04; }
        MouseArtwork { x: 78px; y: 14px; width: parent.width - 156px; height: 252px; }
        Text { y: 272px; width: parent.width; text: root.device-name; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
        Text { y: 305px; width: parent.width; text: root.transport-label; color: Theme.muted; font-size: 11px; horizontal-alignment: center; }
        StatusPill { x: parent.width / 2 - 59px; y: 337px; label: root.lifecycle-text; dot-color: Theme.success; }
        Rectangle { x: 20px; y: 390px; width: parent.width - 40px; height: 1px; background: Theme.border; }
        Text { x: 20px; y: 414px; text: "battery"; color: Theme.muted; font-size: 11px; }
        Text { x: 20px; y: 439px; text: root.battery-text; color: Theme.text; font-size: 18px; font-weight: 700; }
    }
    Card {
        x: 410px; y: 104px; width: parent.width - 438px; height: 340px;
        Text { x: 20px; y: 18px; text: "hardware identity"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Rectangle { x: 20px; y: 52px; width: parent.width - 40px; height: 1px; background: Theme.border; }
        VerticalLayout { x: 20px; y: 62px; width: parent.width - 40px; height: 270px;
            DetailRow { label: "stable id"; value: root.device-id-text; }
            DetailRow { label: "vendor:product"; value: root.device-product-text; }
            DetailRow { label: "transport"; value: root.transport-label; }
            DetailRow { label: "profiles"; value: root.metadata-summary; }
            DetailRow { label: "sensor"; value: root.sensor-summary; }
        }
    }

    Card {
        x: 410px; y: 460px; width: parent.width - 438px; height: 220px;
        Text { x: 20px; y: 18px; text: "configuration evidence"; color: Theme.text; font-size: 16px; font-weight: 700; }
        Text { x: 20px; y: 44px; text: "how the next safe write is checked"; color: Theme.muted; font-size: 10px; }
        ActionButton {
            x: 20px; y: 64px; width: 96px; label: "transport"; compact: true; primary: root.validation-choice == 0; enabled: root.interactive;
            clicked => { root.set-validation-choice(0); }
        }
        ActionButton {
            x: 124px; y: 64px; width: 96px; label: "readback"; compact: true; primary: root.validation-choice == 1; enabled: root.interactive;
            clicked => { root.set-validation-choice(1); }
        }
        Text { x: 230px; y: 70px; width: parent.width - 250px; text: root.validation-choice == 1 ? "fresh USB readback after each write" : "transport submission only"; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
        StatusPill { x: 20px; y: 108px; label: root.validation-choice == 1 ? "readback selected" : "transport selected"; dot-color: root.validation-choice == 1 ? Theme.success : Theme.muted; }
        Text { x: 20px; y: 152px; width: parent.width - 40px; text: "persistence after power loss is unknown. Persistence verification is not implemented."; color: Theme.muted; font-size: 10px; wrap: word-wrap; }
        ActionButton { x: parent.width - 170px; y: 184px; width: 150px; label: "verify persistence (not implemented)"; compact: true; enabled: false; }
    }
}

export component AppWindow inherits Window {
    title: "x3 control";
    preferred-width: 1160px;
    preferred-height: 720px;
    min-width: 1040px;
    min-height: 680px;
    background: Theme.canvas;

    in-out property <int> current-page: 0;
    in-out property <int> selected-profile: 0;
    in-out property <int> active-dpi: 0;
    in-out property <int> validation-choice: 0;
    in-out property <int> selected-rate-hz: 1000;
    in-out property <bool> dirty: false;
    in-out property <bool> busy: false;
    in-out property <bool> hardware-ready: false;
    in-out property <bool> polling-rate-ready: false;
    in-out property <bool> motion-sync-readback: false;
    in-out property <bool> ripple-control-readback: false;
    in-out property <bool> dpi-log-scale: false;
    in-out property <bool> white-mouse: false;
    in-out property <int> product-name-choice: 0;
    in-out property <string> product-name: "USB device not loaded";
    in-out property <string> custom-product-name: "custom mouse";
    in-out property <float> dpi-min: 50.0;
    in-out property <float> dpi-max: 26000.0;
    in-out property <string> dpi-min-text: "50";
    in-out property <string> dpi-max-text: "26000";
    in-out property <string> transport-label: "USB not selected";
    in-out property <string> battery-text: "unavailable";
    in-out property <string> lifecycle-text: "starting";
    in-out property <string> device-name: "USB device not loaded";
    in-out property <string> device-id-text: "not available";
    in-out property <string> device-product-text: "not available";
    in-out property <string> profile-summary: "no live profile";
    in-out property <string> active-dpi-text: "not available";
    in-out property <string> active-stage-text: "not available";
    in-out property <string> polling-rate-text: "not available";
    in-out property <string> sensor-summary: "not available";
    in-out property <string> metadata-summary: "not available";
    in-out property <string> verification-text: "no evidence";
    in-out property <string> status-text: "discovering a compatible USB device";
    in property <[DpiStage]> dpi-stages;
    in property <[BindingRow]> bindings;
    in property <[ProfileRow]> profiles;

    callback navigate(int);
    callback open-config;
    callback select-profile(int);
    callback select-dpi(int);
    callback drag-dpi(int, float);
    callback add-dpi-stage;
    callback remove-dpi-stage(int);
    callback toggle-dpi-scale;
    callback select-product-name(int);
    callback custom-name-changed(string);
    callback toggle-shell;
    callback dpi-min-changed(string);
    callback dpi-max-changed(string);
    callback cycle-binding(int);
    callback toggle-theme;
    callback request-save;
    callback request-reset;
    callback request-refresh;
    callback set-validation-choice(int);
    callback rate-changed(int);

    Rectangle {
        x: 0; y: 0; width: parent.width; height: 62px;
        background: Theme.surface;
        Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }

        Text { x: 20px; width: 150px; height: parent.height; text: root.product-name; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; overflow: elide; }
        Rectangle {
            x: 172px; y: 15px; width: 126px; height: 32px; border-radius: 4px;
            background: Theme.text; opacity: root.hardware-ready ? 1.0 : 0.45;
            Rectangle { x: 10px; y: 12px; width: 7px; height: 7px; border-radius: 4px; background: root.hardware-ready ? Theme.success : Theme.warning; }
            Text { x: 24px; width: 96px; height: parent.height; text: root.transport-label; color: Theme.surface; font-size: 11px; font-weight: 650; vertical-alignment: center; overflow: elide; }
        }
        Text { x: 318px; width: 250px; height: parent.height; text: "battery: " + root.battery-text; color: Theme.text; font-size: 13px; vertical-alignment: center; }

        ActionButton { x: parent.width - 420px; y: 14px; width: 90px; label: root.dirty ? "refresh (discard first)" : "refresh"; compact: true; enabled: !root.busy && !root.dirty; clicked => { root.request-refresh(); } }
        ActionButton { x: parent.width - 318px; y: 14px; width: 126px; label: "discard / reload"; compact: true; enabled: root.hardware-ready && !root.busy; clicked => { root.request-reset(); } }
        Rectangle {
            x: parent.width - 56px; y: 14px; width: 34px; height: 34px; border-radius: 3px; background: theme-area.has-hover ? Theme.surface-raised : transparent;
            Text { text: Theme.dark-mode ? "☾" : "☼"; color: Theme.text; font-size: 22px; horizontal-alignment: center; vertical-alignment: center; }
            theme-area := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-theme(); } }
        }
    }

    Rectangle {
        x: 0; y: 62px; width: 220px; height: parent.height - 62px;
        background: Theme.sidebar;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }

        VerticalLayout {
            x: 12px; y: 14px; width: parent.width - 24px; height: 214px; spacing: 1px;
            NavItem { label: "overview"; icon: @image-url("../assets/home.svg"); selected: root.current-page == 0; clicked => { root.navigate(0); } }
            NavItem { label: "buttons"; icon: @image-url("../assets/cursor.svg"); selected: root.current-page == 1; clicked => { root.navigate(1); } }
            NavItem { label: "sensitivity"; icon: @image-url("../assets/target.svg"); selected: root.current-page == 2; clicked => { root.navigate(2); } }
            NavItem { label: "performance"; icon: @image-url("../assets/pulse.svg"); selected: root.current-page == 3; clicked => { root.navigate(3); } }
            NavItem { label: "advanced"; icon: @image-url("../assets/settings.svg"); selected: root.current-page == 4; clicked => { root.navigate(4); } }
        }

        Card {
            x: 12px; y: 242px; width: parent.width - 24px; height: 314px;
            Text { x: 12px; y: 10px; text: "device profiles"; color: Theme.text; font-size: 13px; font-weight: 700; }
            Text { x: 12px; y: 31px; width: parent.width - 24px; text: "fixed five slots; disabled slots are not editable"; color: Theme.muted; font-size: 9px; wrap: word-wrap; }
            VerticalLayout {
                x: 8px; y: 54px; width: parent.width - 16px; height: 250px; spacing: 5px;
                for profile[index] in root.profiles : ProfileListItem {
                    profile: profile;
                    item-index: index;
                    interactive: root.hardware-ready && !root.busy;
                    selected(index) => { root.select-profile(index); }
                }
            }
            Text { x: 10px; y: parent.height - 30px; width: parent.width - 20px; height: 22px; text: "add / rename / hide: not implemented"; color: Theme.muted; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
        }

        Rectangle {
            x: 12px; y: parent.height - 68px; width: parent.width - 24px; height: 52px;
            border-radius: 4px; background: Theme.accent-soft;
            Rectangle { x: 10px; y: 13px; width: 7px; height: 7px; border-radius: 4px; background: root.hardware-ready ? Theme.success : Theme.warning; }
            Text { x: 24px; y: 8px; text: root.lifecycle-text; color: Theme.text; font-size: 10px; font-weight: 700; overflow: elide; }
            Text { x: 10px; y: 29px; text: root.busy ? "busy — controls locked" : "USB manager state only"; color: Theme.muted; font-size: 9px; }
        }
    }

    Rectangle {
        x: 220px; y: 62px; width: parent.width - 220px; height: parent.height - 106px;
        background: Theme.canvas;
        if root.current-page == 0 : OverviewPage {
            profiles: root.profiles;
            transport-label: root.transport-label;
            battery-text: root.battery-text;
            device-name: root.device-name;
            profile-summary: root.profile-summary;
            active-dpi-text: root.active-dpi-text;
            active-stage-text: root.active-stage-text;
            polling-rate-text: root.polling-rate-text;
            verification-text: root.verification-text;
            hardware-ready: root.hardware-ready;
            select-profile(index) => { root.select-profile(index); }
        }
        if root.current-page == 1 : ButtonsPage { bindings: root.bindings; interactive: root.hardware-ready && !root.busy; cycle-binding(index) => { root.cycle-binding(index); } }
        if root.current-page == 2 : DpiPage {
            dpi-stages: root.dpi-stages;
            logarithmic-scale: root.dpi-log-scale;
            dpi-min: root.dpi-min;
            dpi-max: root.dpi-max;
            interactive: root.hardware-ready && !root.busy;
            motion-sync-readback: root.motion-sync-readback;
            ripple-control-readback: root.ripple-control-readback;
            select-dpi(index) => { root.select-dpi(index); }
            drag-dpi(index, ratio) => { root.drag-dpi(index, ratio); }
            add-dpi-stage => { root.add-dpi-stage(); }
            remove-dpi-stage(index) => { root.remove-dpi-stage(index); }
            toggle-dpi-scale => { root.toggle-dpi-scale(); }
        }
        if root.current-page == 5 : SettingsPage {
            product-name-choice: root.product-name-choice;
            custom-product-name: root.custom-product-name;
            white-mouse: root.white-mouse;
            logarithmic-scale: root.dpi-log-scale;
            dpi-min-text: root.dpi-min-text;
            dpi-max-text: root.dpi-max-text;
            select-product-name(index) => { root.select-product-name(index); }
            custom-name-changed(name) => { root.custom-name-changed(name); }
            toggle-shell => { root.toggle-shell(); }
            toggle-dpi-scale => { root.toggle-dpi-scale(); }
            dpi-min-changed(value) => { root.dpi-min-changed(value); }
            dpi-max-changed(value) => { root.dpi-max-changed(value); }
            back => { root.navigate(0); }
        }
        if root.current-page == 3 : PerformancePage {
            selected-rate-hz <=> root.selected-rate-hz;
            interactive: root.hardware-ready && !root.busy && root.polling-rate-ready;
            baseline-ready: root.polling-rate-ready;
            rate-changed(value) => { root.rate-changed(value); }
        }
        if root.current-page == 4 : DevicePage {
            transport-label: root.transport-label;
            battery-text: root.battery-text;
            device-name: root.device-name;
            device-id-text: root.device-id-text;
            device-product-text: root.device-product-text;
            metadata-summary: root.metadata-summary;
            sensor-summary: root.sensor-summary;
            lifecycle-text: root.lifecycle-text;
            interactive: root.hardware-ready && !root.busy;
            validation-choice: root.validation-choice;
            set-validation-choice(value) => { root.set-validation-choice(value); }
        }
    }

    Rectangle {
        x: 220px; y: parent.height - 44px; width: parent.width - 220px; height: 44px;
        background: Theme.surface;
        Rectangle { width: parent.width; height: 1px; background: Theme.border; }
        Rectangle { x: 16px; y: 18px; width: 7px; height: 7px; border-radius: 4px; background: root.busy ? Theme.warning : root.hardware-ready ? (root.dirty ? Theme.warning : Theme.success) : Theme.warning; }
        Text { x: 32px; width: parent.width - 270px; height: parent.height; text: root.status-text; color: root.busy ? Theme.warning : Theme.muted; font-size: 10px; vertical-alignment: center; overflow: elide; }
        Text { x: parent.width - 258px; width: 86px; height: parent.height; text: root.busy ? "busy" : root.hardware-ready ? (root.dirty ? "draft" : "live readback") : "not connected"; color: root.busy || root.dirty || !root.hardware-ready ? Theme.warning : Theme.success; font-size: 10px; font-weight: 700; horizontal-alignment: right; vertical-alignment: center; }
        ActionButton { x: parent.width - 158px; y: 5px; width: 142px; height: 34px; label: root.dirty ? "save changes" : "no changes"; primary: root.dirty; compact: true; enabled: root.hardware-ready && !root.busy && root.dirty; clicked => { root.request-save(); } }
    }
}
